{"continue":{"iistart":"2013-05-23T01:11:16Z","continue":"||"},"query":{"pages":{"26233760":{"pageid":26233760,"ns":6,"title":"File:Monocot vs Dicot.svg","imagerepository":"local","imageinfo":[{"size":1347312,"width":512,"height":384,"url":"https://upload.wikimedia.org/wikipedia/commons/7/76/Monocot_vs_Dicot.svg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=original","descriptionurl":"https://commons.wikimedia.org/wiki/File:Monocot_vs_Dicot.svg","descriptionshorturl":"https://commons.wikimedia.org/w/index.php?curid=26233760","sha1":"86e3ef136a5d9b1b3b5f5227fc535832cbf147bc","extmetadata":{"DateTime":{"value":"2013-05-23 12:24:23","source":"mediawiki-metadata","hidden":""},"ObjectName":{"value":"Monocot vs Dicot","source":"mediawiki-metadata"},"CommonsMetadataExtension":{"value":1.2,"source":"extension","hidden":""},"Categories":{"value":"Monocots|Self-published work|Plantae diagrams|Angiosperm diagrams","source":"commons-categories","hidden":""},"Assessments":{"value":"","source":"commons-categories","hidden":""},"ImageDescription":{"value":"This diagram is showing the differences between monocotyledonous plants and dicotyledonous plants.  Monocots have a single cotyledon and  long and narrow leaves with parallel veins.  Their vascular bundles are scattered.  Their petals or flower parts are in multiples of three.  Dicots have two cotyledons and broad leaves with network of veins.  Their vascular bundles are in a ring.  Their petals or flower parts are in multiples of four or five.  \n<p><br>\n</p><p><br>\nSources:\n<a href=\"//commons.wikimedia.org/wiki/File:Maple_leaf_macro.jpg\" title=\"File:Maple leaf macro.jpg\">File:Maple_leaf_macro.jpg</a>\n<a href=\"//commons.wikimedia.org/wiki/File:Peanut_cotyledons.jpg\" title=\"File:Peanut cotyledons.jpg\">File:Peanut_cotyledons.jpg</a>\n<a href=\"//commons.wikimedia.org/wiki/File:Botana_curus_monocot_stem_400%C3%97.png\" title=\"File:Botana curus monocot stem 400\u00d7.png\">File:Botana_curus_monocot_stem_400\u00d7.png</a>\n<a href=\"//commons.wikimedia.org/wiki/File:Crassula_ovata5_ies.jpg\" title=\"File:Crassula ovata5 ies.jpg\">File:Crassula_ovata5_ies.jpg</a>\n<a href=\"//commons.wikimedia.org/wiki/File:Tibouchina_urvilleana_flower_ja.jpg\" title=\"File:Tibouchina urvilleana flower ja.jpg\">File:Tibouchina_urvilleana_flower_ja.jpg</a> \n<a href=\"//commons.wikimedia.org/wiki/File:Raoiella_indica_-_red_palm_mite_damage_to_pam_leaf.jpg\" title=\"File:Raoiella indica - red palm mite damage to pam leaf.jpg\">File:Raoiella_indica_-_red_palm_mite_damage_to_pam_leaf.jpg</a>\n<a href=\"//commons.wikimedia.org/wiki/File:Iris_versicolor_3.jpg\" title=\"File:Iris versicolor 3.jpg\">File:Iris_versicolor_3.jpg</a>\n</p>\nMader, Sylvia S. Biology. 10th Ed. New York: McGraw-Hill, 2010. 180. Print.","source":"commons-desc-page"},"DateTimeOriginal":{"value":"2013-05-22 08:50:27","source":"commons-desc-page"},"Credit":{"value":"<span class=\"int-own-work\" lang=\"en\">Own work</span>","source":"commons-desc-page"},"Artist":{"value":"<a href=\"//commons.wikimedia.org/w/index.php?title=User:Flowerpower207&amp;action=edit&amp;redlink=1\" class=\"new\" title=\"User:Flowerpower207 (page does not exist)\">Flowerpower207</a>","source":"commons-desc-page"},"LicenseShortName":{"value":"CC BY-SA 3.0","source":"commons-desc-page","hidden":""},"UsageTerms":{"value":"Creative Commons Attribution-Share Alike 3.0","source":"commons-desc-page"},"AttributionRequired":{"value":"true","source":"commons-desc-page","hidden":""},"LicenseUrl":{"value":"https://creativecommons.org/licenses/by-sa/3.0","source":"commons-desc-page"},"Copyrighted":{"value":"True","source":"commons-desc-page","hidden":""},"Restrictions":{"value":"","source":"commons-desc-page","hidden":""},"License":{"value":"cc-by-sa-3.0","source":"commons-templates","hidden":""}}}]}}}}