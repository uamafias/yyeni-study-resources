{"batchcomplete":"","query":{"pages":{"118651033":{"pageid":118651033,"ns":6,"title":"File:Cross section of leaf.png","imagerepository":"local","imageinfo":[{"size":536932,"width":834,"height":625,"url":"https://upload.wikimedia.org/wikipedia/commons/7/79/Cross_section_of_leaf.png?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=original","descriptionurl":"https://commons.wikimedia.org/wiki/File:Cross_section_of_leaf.png","descriptionshorturl":"https://commons.wikimedia.org/w/index.php?curid=118651033","sha1":"a45629b0b0bba9ad7d6ae64ce2bfdf530b68083a","extmetadata":{"DateTime":{"value":"2022-06-03 13:02:20","source":"mediawiki-metadata","hidden":""},"ObjectName":{"value":"Cross section of leaf","source":"mediawiki-metadata"},"CommonsMetadataExtension":{"value":1.2,"source":"extension","hidden":""},"Categories":{"value":"Self-published work|Microscopic plant diagrams - cross sections of leaves","source":"commons-categories","hidden":""},"Assessments":{"value":"","source":"commons-categories","hidden":""},"ImageDescription":{"value":"This illustration shows the upper and underside of a cross section of a leaf.  The upper most layer is the epidermis, which is covered with a waxy cuticle.  Below the upper epidermis is the palisade mesophyll, which contain photosynthetic cells.  The subsequent layers are the spongy mesophyll and the lower epidermis. The lower epidermis is interspersed with guard cells that form the pores (stomata) through which gases such as oxygen, carbon dioxide and water can enter or exit the leaf tissue.","source":"commons-desc-page"},"DateTimeOriginal":{"value":"2022-06-03","source":"commons-desc-page"},"Credit":{"value":"<span class=\"int-own-work\" lang=\"en\">Own work</span>","source":"commons-desc-page"},"Artist":{"value":"<a href=\"//commons.wikimedia.org/w/index.php?title=User:EunLau&amp;action=edit&amp;redlink=1\" class=\"new\" title=\"User:EunLau (page does not exist)\">ELaurent</a>","source":"commons-desc-page"},"LicenseS