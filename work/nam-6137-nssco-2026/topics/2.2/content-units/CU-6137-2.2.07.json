    {
      "block_id": "BL-6137-2.2.07-07",
      "block_type": "plain_explanation",
      "heading": "",
      "text": "Irrigation deliberately supplies water to crops. It can reduce dependence on the timing of rainfall, support growth through dry intervals and permit suitable crops where rain alone is insufficient. It requires a dependable source, an application system, operation and maintenance. Water quality, cost, availability to other users and crop demand all matter. Installing pipes without securing usable water does not remove the farm's water constraint.",
      "claim_ids": [
        "CL-6137-2.2.07-1",
        "CL-6137-2.2.07-2",
        "CL-6137-2.2.07-01-1",
