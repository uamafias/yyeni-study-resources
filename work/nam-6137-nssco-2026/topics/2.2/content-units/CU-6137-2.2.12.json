    {
      "block_id": "BL-6137-2.2.12-08",
      "block_type": "plain_explanation",
      "heading": "",
      "text": "Salinisation is the accumulation of salts in soil to levels that can impair production or other functions. Irrigation water often contains dissolved salts. Water taken up by plants or lost through evaporation leaves much of that salt behind. Where insufficient drainage and leaching remove it, salts can build up in the root zone. A shallow saline water table can add salt through upward water movement and evaporation.",
      "claim_ids": [
        "CL-6137-2.2.12-1",
        "CL-6137-2.2.12-2",
        "CL-6137-2.2.12-01-1",
        "CL-6137-2.2.12-01-2",
