    {
      "block_id": "BL-6137-3.2.03-08",
      "block_type": "plain_explanation",
      "heading": "",
      "text": "At national level the effects were large before treatment was widely available. United States Census Bureau estimates for 2008 put Namibia's life expectancy at about 50 years, compared with about 71 years in a model without AIDS, and the crude death rate at 14 per 1,000 instead of 5. Population growth was about 0.9% a year instead of 1.9%. WHO estimated that about 57,000 children had lost one or both parents to AIDS by the end of 2003.",
      "claim_ids": [
        "CL-6137-3.2.03-1",
        "CL-6137-3.2.03-2",
        "CL-6137-3.2.03-01-1",
        "CL-6137-3.2.03-01-2",
        "CL-6137-3.2.03-02-1",
        "CL-6137-3.2.03-02-2",
        "CL-6137-3.2.03-03-1",
        "CL-6137-3.2.03-03-2",
        "CL-6137-3.2.03-01-R1"
      ],
      "context_tags": [
