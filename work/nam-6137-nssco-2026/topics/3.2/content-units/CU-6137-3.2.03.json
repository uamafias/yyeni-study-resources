    {
      "block_id": "BL-6137-3.2.03-04",
      "block_type": "worked_application",
      "heading": "",
      "text": "Household effects can involve care needs, income interruption or medical and travel costs during illness. A family member providing care may have less time for other work. Children can face interrupted schooling where household resources or care arrangements are strained. These are conditional pathways, not claims that every household with a member living with HIV experiences school withdrawal or poverty.",
      "claim_ids": [
        "CL-6137-3.2.03-1",
        "CL-6137-3.2.03-2",
        "CL-6137-3.2.03-01-1",
        "CL-6137-3.2.03-01-2",
