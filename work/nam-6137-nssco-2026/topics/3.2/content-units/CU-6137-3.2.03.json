    {
      "block_id": "BL-6137-3.2.03-12",
      "block_type": "plain_explanation",
      "heading": "",
      "text": "Most AIDS deaths occur among adults aged about 15 to 49, the economically active and child-bearing ages. On a population pyramid the bars for these ages become narrower. Social impacts are effects on people, families and communities: more orphans and child-headed households, grandparents caring for grandchildren, children leaving school to nurse sick relatives or earn money, and stigma that isolates families.",
      "claim_ids": [
        "CL-6137-3.2.03-1",
        "CL-6137-3.2.03-2",
        "CL-6137-3.2.03-01-1",
        "CL-6137-3.2.03-01-2",
