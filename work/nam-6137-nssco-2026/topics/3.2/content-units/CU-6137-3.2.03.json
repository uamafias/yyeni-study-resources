    },
    {
      "block_id": "BL-6137-3.2.03-05",
      "block_type": "plain_explanation",
      "heading": "",
      "text": "Stigma and discrimination can create harm separate from the biological infection. Exclusion from employment, fear of disclosure or disrespectful treatment can reduce income or discourage access to services. Accurate information, confidentiality and supportive institutions can reduce those barriers. A social explanation should therefore identify whether a consequence comes from illness, inaccessible care or discrimination, rather than combining them into one inevitable outcome.",
      "claim_ids": [
        "CL-6137-3.2.03-1",
        "CL-6137-3.2.03-2",
        "CL-6137-3.2.03-01-1",
        "CL-6137-3.2.03-01-2",
        "CL-6137-3.2.03-02-1",
        "CL-6137-3.2.03-02-2",
        "CL-6137-3.2.03-03-1",
        "CL-6137-3.2.03-03-2"
      ],
      "context_tags": [
        "Geography",
        "original teaching"
      ],
      "assessment_objectives": [
        "A",
        "B",
        "C"
      ],
      "claims_seen": {
        "CL-6137-3.2.03-1": 1,
        "CL-6137-3.2.03-2": 1,
        "CL-6137-3.2.03-01-1": 1,
        "CL-6137-3.2.03-01-2": 1,
        "CL-6137-3.2.03-02-1": 1,
        "CL-6137-3.2.03-02-2": 1,
