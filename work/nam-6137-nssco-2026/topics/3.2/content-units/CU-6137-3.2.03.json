    },
    {
      "block_id": "BL-6137-3.2.03-06",
      "block_type": "plain_explanation",
      "heading": "",
      "text": "Loss of a parent or caregiver can change household responsibilities and support needs. Outcomes depend on surviving relatives, community arrangements, services and income. It is inaccurate to assume that every child affected by HIV has HIV or that every orphan's situation has the same cause. Published data should specify the category and age group before a conclusion is drawn.",
      "claim_ids": [
        "CL-6137-3.2.03-1",
        "CL-6137-3.2.03-2",
        "CL-6137-3.2.03-01-1",
        "CL-6137-3.2.03-01-2",
        "CL-6137-3.2.03-02-1",
        "CL-6137-3.2.03-02-2",
        "CL-6137-3.2.03-03-1",
        "CL-6137-3.2.03-03-2"
      ],
      "context_tags": [
