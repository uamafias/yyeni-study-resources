        "CL-6137-3.2.03-02-2",
        "CL-6137-3.2.03-03-1",
        "CL-6137-3.2.03-03-2"
      ],
      "context_tags": [
        "Geography",
        "original teaching"
      ],
      "assessment_objectives": [
        "A",
        "B",
        "C"
      ],
      "claims_seen": {
