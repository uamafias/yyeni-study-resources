    {
      "block_id": "BL-6137-3.2.03-07",
      "block_type": "plain_explanation",
      "heading": "",
      "text": "Economic effects can include lost working time during untreated illness, replacement or training costs for enterprises and increased demand on health and support services. Households may sell assets or reduce spending on education or production when income falls and costs rise. The scale depends on actual illness, income protection and usable care. Treatment and non-discriminatory workplaces can preserve participation and reduce some of these pressures.",
      "claim_ids": [
        "CL-6137-3.2.03-1",
        "CL-6137-3.2.03-2",
        "CL-6137-3.2.03-01-1",
        "CL-6137-3.2.03-01-2",
        "CL-6137-3.2.03-02-1",
        "CL-6137-3.2.03-02-2",
