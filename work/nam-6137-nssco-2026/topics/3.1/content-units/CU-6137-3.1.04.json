    {
      "block_id": "BL-6137-3.1.04-13",
      "block_type": "worked_application",
      "heading": "",
      "text": "Migration can reinforce or offset natural change. A growing employment centre may attract residents, while a place with limited opportunities may lose people. Conflict or environmental hazards can force movement, with effects depending on safety and available destinations. A positive natural increase is therefore not sufficient to explain total growth. The migration balance must be considered at the same boundary and period.",
      "claim_ids": [
        "CL-6137-3.1.04-1",
        "CL-6137-3.1.04-2",
        "CL-6137-3.1.04-01-1",
