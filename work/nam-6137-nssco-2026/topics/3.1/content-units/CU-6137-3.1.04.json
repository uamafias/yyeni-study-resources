    {
      "block_id": "BL-6137-3.1.04-12",
      "block_type": "plain_explanation",
      "heading": "",
      "text": "Crude death rates are affected by age structure. A population with many older people can have a relatively high crude death rate even with good age-specific survival. Another with a youthful structure can have a lower crude rate without superior healthcare. Comparing crude rates alone cannot establish which health system is better. Age composition and suitable survival indicators help explain the difference.",
      "claim_ids": [
        "CL-6137-3.1.04-1",
        "CL-6137-3.1.04-2",
        "CL-6137-3.1.04-01-1",
        "CL-6137-3.1.04-01-2",
