  "blocks": [
    {
      "block_id": "BL-6137-3.1.02-01",
      "block_type": "definition",
      "heading": "Births, deaths and migration",
      "text": "Population change is the balance of births, deaths and movement over a defined area and period. Births add people and deaths remove them. Immigration adds residents arriving from outside the area, while emigration removes those leaving it. Natural change is births minus deaths; net migration is arrivals minus departures. Total change combines both balances. State the boundary before deciding whether a movement counts as migration into or out of the population being studied.",
      "claim_ids": [
        "CL-6137-3.1.02-1",
        "CL-6137-3.1.02-2",
        "CL-6137-3.1.02-01-1",
        "CL-6137-3.1.02-01-2",
        "CL-6137-3.1.02-02-1",
        "CL-6137-3.1.02-02-2",
        "CL-6137-3.1.02-03-1",
        "CL-6137-3.1.02-03-2"
      ],
      "context_tags": [
        "Geography",
        "original teaching"
      ],
      "assessment_objectives": [
        "A",
        "B",
        "C"
      ],
      "claims_seen": {
        "CL-6137-3.1.02-1": 1,
        "CL-6137-3.1.02-2": 1,
        "CL-6137-3.1.02-01-1": 1,
        "CL-6137-3.1.02-01-2": 1,
        "CL-6137-3.1.02-02-1": 1,
