    {
      "block_id": "BL-6137-3.1.02-06",
      "block_type": "plain_explanation",
      "heading": "",
      "text": "Immigration and emigration are directional descriptions of movement. A person moving from country A to country B is an emigrant from A and an immigrant to B. The same journey therefore has two perspectives. A positive net migration balance does not mean nobody left; it means arrivals exceeded departures. Similarly, negative net migration does not prove a population fell if natural increase was large enough to outweigh it.",
      "claim_ids": [
        "CL-6137-3.1.02-1",
        "CL-6137-3.1.02-2",
        "CL-6137-3.1.02-01-1",
        "CL-6137-3.1.02-01-2",
        "CL-6137-3.1.02-02-1",
        "CL-6137-3.1.02-02-2",
        "CL-6137-3.1.02-03-1",
        "CL-6137-3.1.02-03-2"
      ],
      "context_tags": [
        "Geography",
        "original teaching"
      ],
      "assessment_objectives": [
        "A",
        "B",
        "C"
      ],
      "claims_seen": {
        "CL-6137-3.1.02-1": 1,
        "CL-6137-3.1.02-2": 1,
        "CL-6137-3.1.02-01-1": 1,
        "CL-6137-3.1.02-01-2": 1,
        "CL-6137-3.1.02-02-1": 1,
        "CL-6137-3.1.02-02-2": 1,
        "CL-6137-3.1.02-03-1": 1,
        "CL-6137-3.1.02-03-2": 1
      },
      "authored_hash": "2e5e9f0190af6c6946e0595aeda3d27f8a884685edf5e57bb794d49eeb078873"
    },
    {
      "block_id": "BL-6137-3.1.02-07",
      "block_type": "plain_explanation",
      "heading": "",
      "text": "Internal migration changes the distribution within a country but does not directly change its national total. A move from a rural Namibian area to Windhoek adds to one local population and subtracts from another. It does not add an extra person to Namibia's total. International migration crosses the national boundary and can change that total. These different scales should remain explicit in both calculation and explanation.",
      "claim_ids": [
        "CL-6137-3.1.02-1",
        "CL-6137-3.1.02-2",
        "CL-6137-3.1.02-01-1",
        "CL-6137-3.1.02-01-2",
        "CL-6137-3.1.02-02-1",
        "CL-6137-3.1.02-02-2",
        "CL-6137-3.1.02-03-1",
        "CL-6137-3.1.02-03-2"
      ],
      "context_tags": [
        "Geography",
        "original teaching"
      ],
      "assessment_objectives": [
        "A",
        "B",
        "C"
      ],
      "claims_seen": {
        "CL-6137-3.1.02-1": 1,
        "CL-6137-3.1.02-2": 1,
        "CL-6137-3.1.02-01-1": 1,
        "CL-6137-3.1.02-01-2": 1,
        "CL-6137-3.1.02-02-1": 1,
        "CL-6137-3.1.02-02-2": 1,
        "CL-6137-3.1.02-03-1": 1,
        "CL-6137-3.1.02-03-2": 1
