      },
      "authored_hash": "ab908833cc368a6ffd9ee8965e4f2b54eacf22c3c7aa2e79ba6f7b577a10566e"
    },
    {
      "block_id": "BL-6137-3.1.02-13",
      "block_type": "worked_application",
      "heading": "",
      "text": "A birth-rate comparison needs the denominator. In a complete teaching record, A has 1,000 live births among a mid-year population of 50,000, giving twenty per 1,000. B has 1,500 among 100,000, giving fifteen per 1,000. B has more births but the lower crude rate. Substituting the birth count for the rate would reverse the interpretation of relative frequency.",
      "claim_ids": [
        "CL-6137-3.1.02-1",
        "CL-6137-3.1.02-2",
        "CL-6137-3.1.02-01-1",
        "CL-6137-3.1.02-01-2",
        "CL-6137-3.1.02-02-1",
        "CL-6137-3.1.02-02-2",
        "CL-6137-3.1.02-03-1",
        "CL-6137-3.1.02-03-2"
      ],
      "context_tags": [
        "Geography",
        "original teaching"
      ],
      "assessment_objectives": [
        "A",
        "B",
        "C"
      ],
      "claims_seen": {
        "CL-6137-3.1.02-1": 1,
        "CL-6137-3.1.02-2": 1,
        "CL-6137-3.1.02-01-1": 1,
        "CL-6137-3.1.02-01-2": 1,
        "CL-6137-3.1.02-02-1": 1,
        "CL-6137-3.1.02-02-2": 1,
        "CL-6137-3.1.02-03-1": 1,
        "CL-6137-3.1.02-03-2": 1
      },
      "authored_hash": "0c5a5b5d0cfb6fb0d2cfe94ff6ebe6151efa7c494b4bc0ff908ddcb35a31ff8d"
    },
    {
      "block_id": "BL-6137-3.1.02-14",
      "block_type": "plain_explanation",
      "heading": "",
      "text": "The same logic applies to deaths. If a population records 500 deaths among 50,000 people, its crude death rate is ten per 1,000. Comparing that with births requires the same period and denominator basis. A table containing annual births and monthly deaths cannot be combined directly. First establish what each number covers, and obtain matching data rather than guessing the missing intervals.",
      "claim_ids": [
        "CL-6137-3.1.02-1",
        "CL-6137-3.1.02-2",
        "CL-6137-3.1.02-01-1",
        "CL-6137-3.1.02-01-2",
        "CL-6137-3.1.02-02-1",
        "CL-6137-3.1.02-02-2",
        "CL-6137-3.1.02-03-1",
        "CL-6137-3.1.02-03-2"
      ],
      "context_tags": [
        "Geography",
        "original teaching"
      ],
      "assessment_objectives": [
        "A",
        "B",
        "C"
      ],
      "claims_seen": {
