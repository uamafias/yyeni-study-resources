      "authored_hash": "dca821a0eff17d5da542a911b36471b56bcb62b53c3192314a99838b1785d27a"
    },
    {
      "block_id": "BL-6137-3.1.02-08",
      "block_type": "plain_explanation",
      "heading": "",
      "text": "A population can grow despite more deaths than births if net immigration is sufficiently positive. It can decline despite natural increase if net emigration is larger in magnitude. For example, natural increase of 200 and net migration of minus 500 give a net decline of 300. Reading only one component would produce the wrong conclusion. A component table should therefore be reconciled before describing the overall direction.",
      "claim_ids": [
        "CL-6137-3.1.02-1",
        "CL-6137-3.1.02-2",
        "CL-6137-3.1.02-01-1",
        "CL-6137-3.1.02-01-2",
        "CL-6137-3.1.02-02-1",
        "CL-6137-3.1.02-02-2",
        "CL-6137-3.1.02-03-1",
        "CL-6137-3.1.02-03-2"
      ],
      "context_tags": [
        "Geography",
        "original teaching"
      ],
      "assessment_objectives": [
        "A",
        "B",
        "C"
      ],
      "claims_seen": {
        "CL-6137-3.1.02-1": 1,
        "CL-6137-3.1.02-2": 1,
        "CL-6137-3.1.02-01-1": 1,
        "CL-6137-3.1.02-01-2": 1,
        "CL-6137-3.1.02-02-1": 1,
        "CL-6137-3.1.02-02-2": 1,
        "CL-6137-3.1.02-03-1": 1,
        "CL-6137-3.1.02-03-2": 1
      },
      "authored_hash": "e5f42dce6230130150395a3c2f45c4e5ff76b25e126522aae11f1e5078b24282"
    },
    {
      "block_id": "BL-6137-3.1.02-09",
      "block_type": "plain_explanation",
      "heading": "",
      "text": "Birth rate differs from total fertility rate. Total fertility rate summarises the average number of children a woman would have under the current age-specific fertility schedule continuing through her reproductive years. Its unit is births per woman, not births per 1,000 total population. Fertility measures and crude birth rates are related but influenced differently by age composition. Do not use the number of children per woman as if it were a percentage growth rate.",
      "claim_ids": [
        "CL-6137-3.1.02-1",
        "CL-6137-3.1.02-2",
        "CL-6137-3.1.02-01-1",
        "CL-6137-3.1.02-01-2",
        "CL-6137-3.1.02-02-1",
        "CL-6137-3.1.02-02-2",
        "CL-6137-3.1.02-03-1",
        "CL-6137-3.1.02-03-2"
      ],
      "context_tags": [
        "Geography",
        "original teaching"
      ],
      "assessment_objectives": [
        "A",
        "B",
        "C"
      ],
      "claims_seen": {
        "CL-6137-3.1.02-1": 1,
        "CL-6137-3.1.02-2": 1,
        "CL-6137-3.1.02-01-1": 1,
        "CL-6137-3.1.02-01-2": 1,
        "CL-6137-3.1.02-02-1": 1,
        "CL-6137-3.1.02-02-2": 1,
        "CL-6137-3.1.02-03-1": 1,
        "CL-6137-3.1.02-03-2": 1
      },
      "authored_hash": "237c477c7676ac2489420284dad9165c766d9945bb6d35eb50bd177780a2de43"
    },
    {
      "block_id": "BL-6137-3.1.02-10",
      "block_type": "plain_explanation",
      "heading": "",
      "text": "Migration is also different from an ordinary short visit or commute. Population movement here concerns a change in usual residence under the relevant definition. A tourism arrival count is not an immigration count merely because someone crossed a border. A census or survey should state its residence and time rules. Those rules help prevent the same temporary movement from being assigned to the wrong population component.",
      "claim_ids": [
        "CL-6137-3.1.02-1",
        "CL-6137-3.1.02-2",
        "CL-6137-3.1.02-01-1",
        "CL-6137-3.1.02-01-2",
        "CL-6137-3.1.02-02-1",
        "CL-6137-3.1.02-02-2",
        "CL-6137-3.1.02-03-1",
        "CL-6137-3.1.02-03-2"
      ],
      "context_tags": [
        "Geography",
        "original teaching"
      ],
      "assessment_objectives": [
        "A",
        "B",
        "C"
      ],
      "claims_seen": {
        "CL-6137-3.1.02-1": 1,
        "CL-6137-3.1.02-2": 1,
        "CL-6137-3.1.02-01-1": 1,
        "CL-6137-3.1.02-01-2": 1,
        "CL-6137-3.1.02-02-1": 1,
        "CL-6137-3.1.02-02-2": 1,
        "CL-6137-3.1.02-03-1": 1,
        "CL-6137-3.1.02-03-2": 1
      },
      "authored_hash": "30761121b25572d30f25fd5a7b1c26ca250d906bdb0810f7c441a9a6fac9c1cf"
    },
    {
      "block_id": "BL-6137-3.1.02-11",
      "block_type": "plain_explanation",
      "heading": "",
      "text": "Records can contain uncertainty. Some births, deaths or moves may be under-recorded, and censuses can require adjustments or estimates. A simplified teaching account states that its components are complete; a real dataset may not. Missing data should not be treated as zero. A sound explanation identifies what the record measures and avoids claiming a precise unobserved cause from an unexplained difference between two totals.",
      "claim_ids": [
        "CL-6137-3.1.02-1",
        "CL-6137-3.1.02-2",
        "CL-6137-3.1.02-01-1",
        "CL-6137-3.1.02-01-2",
        "CL-6137-3.1.02-02-1",
        "CL-6137-3.1.02-02-2",
        "CL-6137-3.1.02-03-1",
        "CL-6137-3.1.02-03-2"
      ],
      "context_tags": [
        "Geography",
        "original teaching"
      ],
      "assessment_objectives": [
        "A",
        "B",
        "C"
      ],
      "claims_seen": {
        "CL-6137-3.1.02-1": 1,
        "CL-6137-3.1.02-2": 1,
        "CL-6137-3.1.02-01-1": 1,
        "CL-6137-3.1.02-01-2": 1,
        "CL-6137-3.1.02-02-1": 1,
        "CL-6137-3.1.02-02-2": 1,
        "CL-6137-3.1.02-03-1": 1,
        "CL-6137-3.1.02-03-2": 1
      },
      "authored_hash": "eb3bce0949f4b1cd1997d1af334d17a8e68ffd893fbb7883eb8dc26b1d4f55a8"
    },
    {
      "block_id": "BL-6137-3.1.02-12",
      "block_type": "plain_explanation",
      "heading": "",
      "text": "A component answer therefore has two stages: describe the observed balance, then explain relevant influences on it. A higher recorded birth rate is an observation; access to education or family-planning services is a possible explanatory influence requiring appropriate evidence. Keeping measurement separate from explanation prevents a plausible general mechanism from being presented as a fact about every household in a particular country.",
      "claim_ids": [
        "CL-6137-3.1.02-1",
        "CL-6137-3.1.02-2",
        "CL-6137-3.1.02-01-1",
        "CL-6137-3.1.02-01-2",
        "CL-6137-3.1.02-02-1",
        "CL-6137-3.1.02-02-2",
        "CL-6137-3.1.02-03-1",
        "CL-6137-3.1.02-03-2"
      ],
      "context_tags": [
        "Geography",
        "original teaching"
      ],
      "assessment_objectives": [
        "A",
        "B",
        "C"
      ],
      "claims_seen": {
        "CL-6137-3.1.02-1": 1,
        "CL-6137-3.1.02-2": 1,
        "CL-6137-3.1.02-01-1": 1,
        "CL-6137-3.1.02-01-2": 1,
        "CL-6137-3.1.02-02-1": 1,
        "CL-6137-3.1.02-02-2": 1,
        "CL-6137-3.1.02-03-1": 1,
