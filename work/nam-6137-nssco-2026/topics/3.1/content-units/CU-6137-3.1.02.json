      "authored_hash": "53780762bd9dbc5f6507588ff560c44f1ebd6838fd3720f94b7221f40b9439d4"
    },
    {
      "block_id": "BL-6137-3.1.02-05",
      "block_type": "worked_application",
      "heading": "",
      "text": "An opening population of 100,000 would become 101,700 under that simplified account if all other adjustments are absent. The percentage change relative to the opening total is 1.7%. This opening-population growth calculation should not be confused with a formally estimated annual demographic rate based on a mid-year population. Use the method and denominator requested by the resource and label the result clearly.",
      "claim_ids": [
        "CL-6137-3.1.02-1",
        "CL-6137-3.1.02-2",
        "CL-6137-3.1.02-01-1",
        "CL-6137-3.1.02-01-2",
        "CL-6137-3.1.02-02-1",
        "CL-6137-3.1.02-02-2",
        "CL-6137-3.1.02-03-1",
        "CL-6137-3.1.02-03-2"
      ],
      "context_tags": [
