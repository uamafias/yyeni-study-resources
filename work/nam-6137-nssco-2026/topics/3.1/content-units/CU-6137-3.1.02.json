    {
      "block_id": "BL-6137-3.1.02-04",
      "block_type": "worked_application",
      "heading": "",
      "text": "Suppose a population records 3,000 births and 1,000 deaths during a year. Natural increase is 2,000 people. If 500 people immigrate and 800 emigrate across the specified boundary, net migration is minus 300 and total change is plus 1,700. These are counts. Calculating rates needs a stated population denominator; the totals alone do not establish the birth or death rate.",
      "claim_ids": [
        "CL-6137-3.1.02-1",
        "CL-6137-3.1.02-2",
        "CL-6137-3.1.02-01-1",
        "CL-6137-3.1.02-01-2",
        "CL-6137-3.1.02-02-1",
        "CL-6137-3.1.02-02-2",
        "CL-6137-3.1.02-03-1",
        "CL-6137-3.1.02-03-2"
      ],
      "context_tags": [
        "Geography",
        "original teaching"
      ],
      "assessment_objectives": [
        "A",
        "B",
        "C"
      ],
      "claims_seen": {
        "CL-6137-3.1.02-1": 1,
        "CL-6137-3.1.02-2": 1,
        "CL-6137-3.1.02-01-1": 1,
        "CL-6137-3.1.02-01-2": 1,
        "CL-6137-3.1.02-02-1": 1,
        "CL-6137-3.1.02-02-2": 1,
        "CL-6137-3.1.02-03-1": 1,
        "CL-6137-3.1.02-03-2": 1
