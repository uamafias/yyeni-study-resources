    {
      "block_id": "BL-6137-3.1.06-01",
      "block_type": "definition",
      "heading": "The Demographic Transition Model",
      "text": "The Demographic Transition Model describes a broad transition from high birth and death rates to low birth and death rates. Its main teaching version here uses four stages. The gap between the rates indicates natural change when measured on the same basis, while the population total accumulates earlier changes. Migration is not the main mechanism represented by the basic model, so a country's total growth can differ from the model's natural-change pattern.",
      "claim_ids": [
        "CL-6137-3.1.06-1",
        "CL-6137-3.1.06-2",
        "CL-6137-3.1.06-01-1",
