      "authored_hash": "51d58c87c9eaffafebd4b463e5b4d23b9c3fafb0aa7c6b2f7a2afb94807e3bad"
    },
    {
      "block_id": "BL-6137-3.1.05-19",
      "block_type": "worked_application",
      "heading": "",
      "text": "Older-age needs are also varied. Some people require intensive care, others remain active and independent, and many contribute family support or experience. The age share alone cannot supply the exact healthcare budget. Suitable service and health records help determine needs. A respectful explanation discusses the changing balance of services and resources without describing every older person as economically inactive or dependent in the same way.",
      "claim_ids": [
