    {
      "block_id": "BL-6137-4.1.04-04",
      "block_type": "plain_explanation",
      "heading": "",
      "text": "Systematic sampling selects at regular intervals in space, time or an ordered list, often after a suitable random start. Examples include every tenth metre along a safe transect or every fifth eligible passer-by. State the start, interval and eligibility rule. A systematic design provides orderly coverage and can be practical for comparing gradients, but its interval can align with a repeating feature and distort representation.",
      "claim_ids": [
        "CL-6137-4.1.04-1",
        "CL-6137-4.1.04-2",
        "CL-6137-4.1.04-01-1",
        "CL-6137-4.1.04-01-2",
        "CL-6137-4.1.04-02-1",
        "CL-6137-4.1.04-02-2",
        "CL-6137-4.1.04-03-1",
        "CL-6137-4.1.04-03-2"
      ],
      "context_tags": [
        "Geography",
        "original teaching"
      ],
      "assessment_objectives": [
        "A",
        "B",
        "C",
        "D"
      ],
      "claims_seen": {
        "CL-6137-4.1.04-1": 1,
        "CL-6137-4.1.04-2": 1,
        "CL-6137-4.1.04-01-1": 1,
        "CL-6137-4.1.04-01-2": 1,
        "CL-6137-4.1.04-02-1": 1,
        "CL-6137-4.1.04-02-2": 1,
