    {
      "block_id": "BL-6137-4.1.04-01",
      "block_type": "definition",
      "heading": "Random, systematic and stratified sampling",
      "text": "Random sampling selects through a chance mechanism within a defined eligible frame. In a simple random design, eligible members have a known equal chance of selection. A numbered list and suitable random-number method can choose sites or respondents. Random does not mean selecting whichever location feels convenient or wandering without a rule. The frame and mechanism should be stated clearly enough to repeat the selection process.",
      "claim_ids": [
        "CL-6137-4.1.04-1",
        "CL-6137-4.1.04-2",
        "CL-6137-4.1.04-01-1",
