    {
      "block_id": "BL-6137-4.1.04-05",
      "block_type": "worked_application",
      "heading": "",
      "text": "Suppose observations are taken every ten metres along a 100-metre safe route, beginning at a stated start. The rule supplies regular spacing, not a random selection of all possible points. If a repeating management feature also occurs every ten metres, the design could overrepresent it. Changing the interval or using an appropriate stratified/random element may address that specific problem. More observations at the same biased interval may leave the problem intact.",
      "claim_ids": [
        "CL-6137-4.1.04-1",
        "CL-6137-4.1.04-2",
        "CL-6137-4.1.04-01-1",
        "CL-6137-4.1.04-01-2",
        "CL-6137-4.1.04-02-1",
        "CL-6137-4.1.04-02-2",
        "CL-6137-4.1.04-03-1",
        "CL-6137-4.1.04-03-2"
      ],
      "context_tags": [
