    {
      "block_id": "BL-6137-4.1.04-03",
      "block_type": "plain_explanation",
      "heading": "",
      "text": "Chance selection reduces some investigator preference, but a small random sample can cluster or miss a rare zone. Repeating selection in a different sample may give different results. A larger appropriate sample can improve coverage, while clear framing remains necessary. A random sample from only one car park cannot represent all residents of a town if many residents never enter the frame.",
      "claim_ids": [
        "CL-6137-4.1.04-1",
        "CL-6137-4.1.04-2",
        "CL-6137-4.1.04-01-1",
        "CL-6137-4.1.04-01-2",
