    {
      "block_id": "BL-6137-4.1.04-06",
      "block_type": "plain_explanation",
      "heading": "",
      "text": "Stratified sampling divides the population into relevant groups or zones before selecting within them. A tourism investigation can separate busy and quiet zones or residents and visitors where both populations are relevant. The within-group rule might be random or systematic. Stratification concerns planned group coverage, not permission to choose only the easiest people in each group. Record group definitions and how selection occurs.",
      "claim_ids": [
        "CL-6137-4.1.04-1",
        "CL-6137-4.1.04-2",
        "CL-6137-4.1.04-01-1",
        "CL-6137-4.1.04-01-2",
        "CL-6137-4.1.04-02-1",
        "CL-6137-4.1.04-02-2",
        "CL-6137-4.1.04-03-1",
        "CL-6137-4.1.04-03-2"
      ],
      "context_tags": [
        "Geography",
        "original teaching"
      ],
      "assessment_objectives": [
        "A",
        "B",
        "C",
        "D"
      ],
      "claims_seen": {
