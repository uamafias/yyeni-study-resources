      "authored_hash": "e6dd7af5afbd3f739ad57ed9156058f262759e7213967f6471a7397af39ebc6c"
    },
    {
      "block_id": "BL-6137-4.1.08-08",
      "block_type": "plain_explanation",
      "heading": "",
      "text": "Recommendations connect the finding to a relevant action. If litter collection fails at peak use, an appropriate collection response addresses a different issue from a housing or path-width problem. If a result does not show the predicted deterioration, the recommendation should not assume it did. Explain the link from evidence to action, including practical conditions and possible effects on other users.",
      "claim_ids": [
        "CL-6137-4.1.08-1",
        "CL-6137-4.1.08-2",
        "CL-6137-4.1.08-01-1",
        "CL-6137-4.1.08-01-2",
        "CL-6137-4.1.08-02-1",
        "CL-6137-4.1.08-02-2",
        "CL-6137-4.1.08-03-1",
        "CL-6137-4.1.08-03-2"
      ],
      "context_tags": [
