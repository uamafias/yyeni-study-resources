    {
      "block_id": "BL-6137-4.1.08-10",
      "block_type": "plain_explanation",
      "heading": "",
      "text": "The final account should allow a reader to follow question, method, evidence and judgement. Keep raw values, selection rules, calculations, figures and any documented changes together. A neat final number does not make an enquiry stronger than its collection process. Honest limits and specific improvements make the results more useful for later learning and management than a confident unsupported conclusion.",
      "claim_ids": [
        "CL-6137-4.1.08-1",
        "CL-6137-4.1.08-2",
        "CL-6137-4.1.08-01-1",
        "CL-6137-4.1.08-01-2",
        "CL-6137-4.1.08-02-1",
        "CL-6137-4.1.08-02-2",
        "CL-6137-4.1.08-03-1",
        "CL-6137-4.1.08-03-2"
      ],
      "context_tags": [
