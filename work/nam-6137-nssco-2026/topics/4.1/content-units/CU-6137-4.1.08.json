      "authored_hash": "9b0171c531fa7430340c0b2f3c7dbf6e2dcf6a88c9a9aa303746ad4843f9b7c6"
    },
    {
      "block_id": "BL-6137-4.1.08-14",
      "block_type": "plain_explanation",
      "heading": "",
      "text": "The managed/reference pollution comparison can support an observed improvement at the managed site while leaving exact causation open. A fall from four to two at one site and rise from three to four at the reference makes the paired contrast visible, but cleaning schedules, weather or other changes could still differ. Matched observation and relevant context help test those alternatives. The management label itself does not supply the missing control.",
      "claim_ids": [
        "CL-6137-4.1.08-1",
        "CL-6137-4.1.08-2",
        "CL-6137-4.1.08-01-1",
        "CL-6137-4.1.08-01-2",
