        "original teaching"
      ],
      "assessment_objectives": [
        "A",
        "B",
        "C",
        "D"
      ],
      "claims_seen": {
        "CL-6137-4.1.08-1": 1,
        "CL-6137-4.1.08-2": 1,
        "CL-6137-4.1.08-01-1": 1,
        "CL-6137-4.1.08-01-2": 1,
        "CL-6137-4.1.08-02-1": 1,
        "CL-6137-4.1.08-02-2": 1,
        "CL-6137-4.1.08-03-1": 1,
