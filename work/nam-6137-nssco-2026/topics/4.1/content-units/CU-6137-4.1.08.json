    {
      "block_id": "BL-6137-4.1.08-04",
      "block_type": "plain_explanation",
      "heading": "",
      "text": "Evaluation examines how method or evidence limits confidence. Distinguish random reading variation, systematic measurement problems, sampling coverage, subjective scoring, non-response, unmatched times and uncertain secondary data. These have different effects. A larger sample addresses some coverage issues but not a wrongly calibrated instrument; repeat measurements address some variability but not a leading survey question.",
      "claim_ids": [
        "CL-6137-4.1.08-1",
        "CL-6137-4.1.08-2",
        "CL-6137-4.1.08-01-1",
        "CL-6137-4.1.08-01-2",
        "CL-6137-4.1.08-02-1",
        "CL-6137-4.1.08-02-2",
        "CL-6137-4.1.08-03-1",
        "CL-6137-4.1.08-03-2"
      ],
      "context_tags": [
        "Geography",
        "original teaching"
      ],
      "assessment_objectives": [
        "A",
        "B",
        "C",
        "D"
      ],
      "claims_seen": {
        "CL-6137-4.1.08-1": 1,
        "CL-6137-4.1.08-2": 1,
        "CL-6137-4.1.08-01-1": 1,
        "CL-6137-4.1.08-01-2": 1,
        "CL-6137-4.1.08-02-1": 1,
        "CL-6137-4.1.08-02-2": 1,
        "CL-6137-4.1.08-03-1": 1,
        "CL-6137-4.1.08-03-2": 1
