      },
      "authored_hash": "a98852a90b368a9898bd265fef9940f62557807d4deba95b7a1d30be0ecce8e1"
    },
    {
      "block_id": "BL-6137-4.1.08-12",
      "block_type": "plain_explanation",
      "heading": "",
      "text": "For tracers, a +2-metre mean among four recoveries supports net northward movement for the recovered subset, not northward movement of every released tracer. One recovery is southward and one released tracer is missing. A conclusion can state the useful net result while retaining both exceptions. Repeating the release or improving safe recovery coverage could strengthen later evidence without changing what the present observations show.",
      "claim_ids": [
        "CL-6137-4.1.08-1",
        "CL-6137-4.1.08-2",
        "CL-6137-4.1.08-01-1",
        "CL-6137-4.1.08-01-2",
        "CL-6137-4.1.08-02-1",
        "CL-6137-4.1.08-02-2",
        "CL-6137-4.1.08-03-1",
        "CL-6137-4.1.08-03-2"
      ],
      "context_tags": [
        "Geography",
        "original teaching"
