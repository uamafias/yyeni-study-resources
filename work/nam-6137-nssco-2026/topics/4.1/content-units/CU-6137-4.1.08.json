      "authored_hash": "4be82b067211a06f8c9e6878b5cd205a5db0ceba3db4d163ea4434fc235aac77"
    },
    {
      "block_id": "BL-6137-4.1.08-09",
      "block_type": "plain_explanation",
      "heading": "",
      "text": "A report should retain scope and uncertainty. A four-site sample can describe those sites and support a cautious local interpretation. Wider claims need suitable coverage and compatible evidence. An official secondary dataset may provide that wider context, while its definitions and dates still require attention. Combining records is useful only where their meanings align.",
      "claim_ids": [
        "CL-6137-4.1.08-1",
        "CL-6137-4.1.08-2",
        "CL-6137-4.1.08-01-1",
        "CL-6137-4.1.08-01-2",
        "CL-6137-4.1.08-02-1",
        "CL-6137-4.1.08-02-2",
        "CL-6137-4.1.08-03-1",
        "CL-6137-4.1.08-03-2"
      ],
      "context_tags": [
