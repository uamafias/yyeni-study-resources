    {
      "block_id": "BL-6137-4.1.08-11",
      "block_type": "plain_explanation",
      "heading": "",
      "text": "The evidence can support one hypothesis and reject another. In the coastal teaching dataset, mean pebble size rises twelve,twenty-two,thirty-two millimetres, while gradients are 1:25,1:20,1:40. The size prediction of increase is supported at the three stations, whereas a prediction that gradient steepens at every step is not. The conclusion should not combine them into a single claim that all coastal conditions change in the same direction.",
      "claim_ids": [
        "CL-6137-4.1.08-1",
        "CL-6137-4.1.08-2",
        "CL-6137-4.1.08-01-1",
        "CL-6137-4.1.08-01-2",
        "CL-6137-4.1.08-02-1",
        "CL-6137-4.1.08-02-2",
        "CL-6137-4.1.08-03-1",
        "CL-6137-4.1.08-03-2"
      ],
      "context_tags": [
        "Geography",
        "original teaching"
      ],
      "assessment_objectives": [
        "A",
        "B",
        "C",
        "D"
      ],
      "claims_seen": {
