    {
      "block_id": "BL-6137-2.5.01-04",
      "block_type": "plain_explanation",
      "heading": "",
      "text": "Industrial uses include processing, cooling, washing equipment and other operation-specific needs. Different industries require different quantities and quality. Some can use appropriately treated non-potable water for a particular task, while others require more stringent treatment. Reusing water can reduce fresh-water demand where the process permits, but it requires suitable quality control and equipment. A factory's presence does not establish a fixed universal consumption rate.",
      "claim_ids": [
        "CL-6137-2.5.01-1",
        "CL-6137-2.5.01-2",
        "CL-6137-2.5.01-01-1",
        "CL-6137-2.5.01-01-2",
