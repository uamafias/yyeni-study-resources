      "authored_hash": "6e8933941b95c1012c237a72f440afa24bf86ee124b0a7c7efe5f1d657108f66"
    },
    {
      "block_id": "BL-6137-2.5.01-15",
      "block_type": "worked_application",
      "heading": "",
      "text": "A user can withdraw water without consuming all of it in the same sense. Some may return to a river or treatment system, though its timing, location and quality can change. A return flow unsuitable for immediate reuse is not equivalent to an unchanged supply. When comparing sectors, read what the resource measures. Withdrawal, net consumption, treated delivery and a billable volume can produce different totals for understandable reasons.",
      "claim_ids": [
        "CL-6137-2.5.01-1",
        "CL-6137-2.5.01-2",
        "CL-6137-2.5.01-01-1",
        "CL-6137-2.5.01-01-2",
        "CL-6137-2.5.01-02-1",
