    {
      "block_id": "BL-6137-2.5.01-14",
      "block_type": "worked_application",
      "heading": "",
      "text": "A source mix does not eliminate competition. More water from one source may have pumping, treatment, energy or ecological costs. A demand reduction can defer new capacity while requiring cooperation and appropriate equipment. Compare the service gained and the wider effects over the relevant period. The aim is a usable, dependable and appropriately allocated resource, rather than the largest possible abstraction from every source.",
      "claim_ids": [
        "CL-6137-2.5.01-1",
        "CL-6137-2.5.01-2",
        "CL-6137-2.5.01-01-1",
        "CL-6137-2.5.01-01-2",
        "CL-6137-2.5.01-02-1",
        "CL-6137-2.5.01-02-2",
        "CL-6137-2.5.01-03-1",
        "CL-6137-2.5.01-03-2",
        "CL-6137-2.5.01-04-1",
        "CL-6137-2.5.01-04-2"
      ],
      "context_tags": [
