      ],
      "assessment_objectives": [
        "A",
        "B",
        "C"
      ],
      "claims_seen": {
        "CL-6137-2.5.01-1": 1,
        "CL-6137-2.5.01-2": 1,
        "CL-6137-2.5.01-01-1": 1,
