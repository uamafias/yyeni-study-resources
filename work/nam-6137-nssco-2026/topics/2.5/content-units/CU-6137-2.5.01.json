        "CL-6137-2.5.01-03-1",
        "CL-6137-2.5.01-03-2",
        "CL-6137-2.5.01-04-1",
        "CL-6137-2.5.01-04-2"
      ],
      "context_tags": [
        "Geography",
        "original teaching"
