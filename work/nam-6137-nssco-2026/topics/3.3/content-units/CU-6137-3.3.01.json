    {
      "block_id": "BL-6137-3.3.01-07",
      "block_type": "plain_explanation",
      "heading": "",
      "text": "Pattern also depends on the map's extent. Several separate farmsteads can appear dispersed within one district, while the district's villages may be clustered at a national scale. A small inset can make a line or cluster visible that is lost on a national map. Read the boundary and scale so a local observation is not extended to an entire country.",
      "claim_ids": [
        "CL-6137-3.3.01-1",
        "CL-6137-3.3.01-2",
        "CL-6137-3.3.01-01-1",
