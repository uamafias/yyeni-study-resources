    {
      "block_id": "BL-6137-3.3.01-02",
      "block_type": "plain_explanation",
      "heading": "",
      "text": "In a dispersed pattern, individual dwellings or farmsteads lie separately across the area. Agricultural land can lie between them, and households may be close to their own fields or grazing operations. The pattern does not mean the land is uninhabited or that each home lacks services. The spacing describes location. Access, infrastructure and livelihood evidence are needed to explain why a particular arrangement developed.",
      "claim_ids": [
        "CL-6137-3.3.01-1",
        "CL-6137-3.3.01-2",
        "CL-6137-3.3.01-01-1",
        "CL-6137-3.3.01-01-2",
        "CL-6137-3.3.01-02-1",
        "CL-6137-3.3.01-02-2",
        "CL-6137-3.3.01-03-1",
        "CL-6137-3.3.01-03-2"
      ],
      "context_tags": [
