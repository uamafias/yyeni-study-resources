    {
      "block_id": "BL-6137-3.3.01-10",
      "block_type": "plain_explanation",
      "heading": "",
      "text": "The three pattern names are useful descriptions rather than a ranking of quality. Dispersed homes can provide proximity to fields but longer service routes; clustered homes can share some facilities while requiring journeys to land; linear development can provide route access while creating an elongated service corridor. These are conditional trade-offs, not outcomes established for every settlement with the same shape.",
      "claim_ids": [
        "CL-6137-3.3.01-1",
        "CL-6137-3.3.01-2",
        "CL-6137-3.3.01-01-1",
        "CL-6137-3.3.01-01-2",
        "CL-6137-3.3.01-02-1",
        "CL-6137-3.3.01-02-2",
        "CL-6137-3.3.01-03-1",
        "CL-6137-3.3.01-03-2"
      ],
      "context_tags": [
