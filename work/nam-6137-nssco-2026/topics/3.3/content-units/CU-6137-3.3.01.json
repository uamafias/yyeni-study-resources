  "blocks": [
    {
      "block_id": "BL-6137-3.3.01-01",
      "block_type": "definition",
      "heading": "Rural settlement patterns",
      "text": "Settlement pattern describes the arrangement of dwellings rather than simply how many people live in an area. Dispersed settlement has dwellings spread apart; nucleated settlement groups them into a cluster; linear settlement follows an elongated alignment. A map can show combinations, so choose the pattern supported at the requested scale. A village may have a clustered centre with houses extending along one road.",
      "claim_ids": [
        "CL-6137-3.3.01-1",
        "CL-6137-3.3.01-2",
        "CL-6137-3.3.01-01-1",
        "CL-6137-3.3.01-01-2",
