      "authored_hash": "eb6e5150b254d67d658ec2665a725a06df17fbb40461b298cd04551e75413c84"
    },
    {
      "block_id": "BL-6137-3.3.02-15",
      "block_type": "plain_explanation",
      "heading": "",
      "text": "Agricultural work can encourage different relationships between home and land. A household managing scattered plots may value a village base with shared services, while a large separate holding may support a home near livestock and equipment. These are mechanisms, not universal ownership rules. The actual tenure and work arrangement are needed before explaining the dwellings' spacing from a land-use map alone.",
      "claim_ids": [
        "CL-6137-3.3.02-1",
        "CL-6137-3.3.02-2",
        "CL-6137-3.3.02-01-1",
        "CL-6137-3.3.02-01-2",
        "CL-6137-3.3.02-02-1",
        "CL-6137-3.3.02-02-2",
        "CL-6137-3.3.02-03-1",
        "CL-6137-3.3.02-03-2",
        "CL-6137-3.3.02-04-1",
        "CL-6137-3.3.02-04-2"
      ],
      "context_tags": [
        "Geography",
        "original teaching"
      ],
      "assessment_objectives": [
        "A",
        "B",
        "C"
      ],
      "claims_seen": {
        "CL-6137-3.3.02-1": 1,
        "CL-6137-3.3.02-2": 1,
        "CL-6137-3.3.02-01-1": 1,
        "CL-6137-3.3.02-01-2": 1,
        "CL-6137-3.3.02-02-1": 1,
        "CL-6137-3.3.02-02-2": 1,
        "CL-6137-3.3.02-03-1": 1,
        "CL-6137-3.3.02-03-2": 1,
        "CL-6137-3.3.02-04-1": 1,
        "CL-6137-3.3.02-04-2": 1
      },
      "authored_hash": "81a1bdf221ae4aa1406cc901cd3cd2d48775eddc8af1f5382f67081603a94112"
    },
    {
      "block_id": "BL-6137-3.3.02-16",
      "block_type": "plain_explanation",
      "heading": "",
      "text": "Infrastructure can alter a pattern's practical consequences. A dispersed settlement connected by dependable roads and services may have better access than a cluster with unusable routes. Conversely, a compact group can reduce some network distances where shared systems operate. Service cost and availability therefore need measurement; shape is not a direct score of development. The comparison should use the same service and period.",
      "claim_ids": [
        "CL-6137-3.3.02-1",
        "CL-6137-3.3.02-2",
        "CL-6137-3.3.02-01-1",
        "CL-6137-3.3.02-01-2",
        "CL-6137-3.3.02-02-1",
