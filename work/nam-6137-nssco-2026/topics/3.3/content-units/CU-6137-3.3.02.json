        "CL-6137-3.3.02-03-1",
        "CL-6137-3.3.02-03-2",
        "CL-6137-3.3.02-04-1",
        "CL-6137-3.3.02-04-2"
      ],
      "context_tags": [
        "Geography",
        "original teaching"
      ],
      "assessment_objectives": [
        "A",
        "B",
        "C"
