  "blocks": [
    {
      "block_id": "BL-6137-3.3.02-01",
      "block_type": "definition",
      "heading": "Factors influencing rural size and pattern",
      "text": "Rural settlement reflects physical opportunities and constraints interacting with access, agriculture, policy and history. Relief, soil and water can affect feasible sites, while land rights and infrastructure shape where households can use them. The syllabus's LEDC and MEDC labels provide broad comparison contexts, not a rule assigning one pattern to each country group. Dispersed, linear and nucleated forms can occur in different economies.",
      "claim_ids": [
        "CL-6137-3.3.02-1",
        "CL-6137-3.3.02-2",
