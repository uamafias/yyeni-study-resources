      "authored_hash": "44ab5d7938e190360317f01bf29f74e518a5207298075f60495f849cec3742d4"
    },
    {
      "block_id": "BL-6137-3.3.02-09",
      "block_type": "plain_explanation",
      "heading": "",
      "text": "Political factors include land allocation, planned settlement, service policy and historical restrictions. A planned village can place houses in a nucleus or grid, while past dispossession can shape access to land and investment. These are human decisions, not natural consequences of relief or rainfall. A fair explanation should avoid presenting historical inequalities as differences in people's inherent preferences or ability.",
      "claim_ids": [
        "CL-6137-3.3.02-1",
        "CL-6137-3.3.02-2",
        "CL-6137-3.3.02-01-1",
        "CL-6137-3.3.02-01-2",
