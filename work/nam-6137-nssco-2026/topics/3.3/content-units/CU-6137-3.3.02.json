      "authored_hash": "75976191b3b2ae81c15ef9e8ae4b81f688c7da0f6bb1b2b698a01e8ed2f793a5"
    },
    {
      "block_id": "BL-6137-3.3.02-14",
      "block_type": "worked_application",
      "heading": "",
      "text": "The same physical feature can create an opportunity and a constraint. A river can provide a potential source and a route through a valley, while flooding threatens low ground. An elevated site may reduce one flood risk but increase the cost of moving water uphill. A location decision should weigh the relevant trade-off rather than call river proximity entirely good or bad. The resource must show which conditions apply.",
      "claim_ids": [
        "CL-6137-3.3.02-1",
        "CL-6137-3.3.02-2",
        "CL-6137-3.3.02-01-1",
        "CL-6137-3.3.02-01-2",
        "CL-6137-3.3.02-02-1",
        "CL-6137-3.3.02-02-2",
        "CL-6137-3.3.02-03-1",
        "CL-6137-3.3.02-03-2",
        "CL-6137-3.3.02-04-1",
        "CL-6137-3.3.02-04-2"
      ],
      "context_tags": [
        "Geography",
