      "authored_hash": "930ff94a36e023469917be5ba33dee0d790829a8e22165a9d7ae8a1c3a51f3b9"
    },
    {
      "block_id": "BL-6137-3.3.02-10",
      "block_type": "plain_explanation",
      "heading": "",
      "text": "Policy can also encourage conservation, protect hazard zones or reserve productive land. The resulting pattern depends on implementation and people's feasible options. A regulation on paper does not establish that every dwelling follows it. Comparing approved plans with actual dated settlement maps can identify differences, while interviews or records help explain them. Do not infer compliance solely from the existence of a planning boundary.",
      "claim_ids": [
        "CL-6137-3.3.02-1",
        "CL-6137-3.3.02-2",
        "CL-6137-3.3.02-01-1",
