    {
      "block_id": "BL-6137-3.3.02-02",
      "block_type": "worked_application",
      "heading": "",
      "text": "Relief influences construction and movement. Gentle ground can make building and access easier where other conditions are suitable, while steep slopes can raise costs or restrict available sites. A narrow valley may concentrate development along a route or flatter strip. These tendencies need the actual resource evidence. A steep area can still contain settlement through suitable design, and a plain can remain sparsely settled for other reasons.",
      "claim_ids": [
        "CL-6137-3.3.02-1",
        "CL-6137-3.3.02-2",
        "CL-6137-3.3.02-01-1",
        "CL-6137-3.3.02-01-2",
        "CL-6137-3.3.02-02-1",
        "CL-6137-3.3.02-02-2",
        "CL-6137-3.3.02-03-1",
        "CL-6137-3.3.02-03-2",
        "CL-6137-3.3.02-04-1",
        "CL-6137-3.3.02-04-2"
      ],
      "context_tags": [
