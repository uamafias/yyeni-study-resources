      "authored_hash": "f61648cfc29a8c42f888a14a4772724477711b5236863f7036dfcb62db11f241"
    },
    {
      "block_id": "BL-6137-3.3.02-06",
      "block_type": "plain_explanation",
      "heading": "",
      "text": "Accessibility concerns the ease of reaching work, services, markets and other places. Roads, paths, public transport and terrain can influence travel time and cost. A roadside line of houses can reflect a desire for access, while a crossroads can support a nucleus of services. Distance in a straight line is not the same as a practical route. A nearby clinic across an impassable channel may be less accessible than a farther one on a dependable road.",
      "claim_ids": [
        "CL-6137-3.3.02-1",
        "CL-6137-3.3.02-2",
        "CL-6137-3.3.02-01-1",
        "CL-6137-3.3.02-01-2",
