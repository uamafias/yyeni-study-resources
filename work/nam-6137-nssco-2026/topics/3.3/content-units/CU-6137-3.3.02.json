      "authored_hash": "69f2d8485a601f330d299ad8f1fd94579049678c56c4f7f96d16507fc43f5796"
    },
    {
      "block_id": "BL-6137-3.3.02-17",
      "block_type": "plain_explanation",
      "heading": "",
      "text": "Political decisions can leave a pattern after their immediate purpose changes. Earlier planned sites, restrictions or transport investments can continue shaping settlement even when economic activities shift. A present map may show that legacy without explaining it. Historical records and dated maps support a stronger causal account than assigning every current pattern to present-day physical conditions.",
      "claim_ids": [
        "CL-6137-3.3.02-1",
        "CL-6137-3.3.02-2",
        "CL-6137-3.3.02-01-1",
