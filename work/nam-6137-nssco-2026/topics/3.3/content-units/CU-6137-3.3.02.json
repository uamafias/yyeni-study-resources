      "authored_hash": "57822ded80abb14047cf9ea0f3b14e18d57b7c5a1e44096ed12b8ce2eb1777f6"
    },
    {
      "block_id": "BL-6137-3.3.02-08",
      "block_type": "plain_explanation",
      "heading": "",
      "text": "Households may also combine farming with other livelihoods. A village near a road can provide services, trade or commuting opportunities. Changing access can alter the balance between living near land and living near facilities. A new route might encourage an extension without changing every older dwelling. To explain the change, compare the dates and actual new locations rather than assume the whole pattern was built at once.",
      "claim_ids": [
        "CL-6137-3.3.02-1",
        "CL-6137-3.3.02-2",
        "CL-6137-3.3.02-01-1",
        "CL-6137-3.3.02-01-2",
