      "authored_hash": "2fbf4b1d14b3b29e28ee01d871ea1395855dc6edf775b82b8310735913d1db6d"
    },
    {
      "block_id": "BL-6137-3.3.02-05",
      "block_type": "plain_explanation",
      "heading": "",
      "text": "A shared water point may help explain a cluster where alternatives are distant, while individual boreholes can support more dispersed occupation under suitable aquifer and service conditions. The water point's presence does not prove that it caused the settlement or that it remains dependable today. Historical or service evidence strengthens the explanation. Distinguish an enabling condition from a demonstrated origin story.",
      "claim_ids": [
        "CL-6137-3.3.02-1",
        "CL-6137-3.3.02-2",
        "CL-6137-3.3.02-01-1",
        "CL-6137-3.3.02-01-2",
