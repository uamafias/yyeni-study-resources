      },
      "authored_hash": "dc77006295335d23aa4c1f1dd8e83fa5bd1849ed33d0a0925184d78b19fdba71"
    },
    {
      "block_id": "BL-6137-3.3.02-07",
      "block_type": "plain_explanation",
      "heading": "",
      "text": "Agricultural land use can shape spacing. Large separate holdings may support farmsteads among their fields or grazing areas, while shared village arrangements can cluster homes with agricultural land outside. Labour, land tenure, machinery and the location of fields affect the trade-off. A dispersed pattern does not prove large commercial ownership, and a cluster does not prove subsistence. Production purpose and settlement shape are separate dimensions.",
      "claim_ids": [
        "CL-6137-3.3.02-1",
        "CL-6137-3.3.02-2",
        "CL-6137-3.3.02-01-1",
        "CL-6137-3.3.02-01-2",
