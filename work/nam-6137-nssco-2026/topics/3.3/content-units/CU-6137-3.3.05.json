    {
      "block_id": "BL-6137-3.3.05-06",
      "block_type": "plain_explanation",
      "heading": "",
      "text": "Informal settlements can develop where residents cannot obtain sufficient affordable, appropriately located and serviced land or housing through formal systems. Conditions vary. Some areas lack essential services or secure arrangements, while residents create homes, enterprises and community networks under constrained options. Informality should not be treated as proof of criminality, lack of effort or an identical condition in every dwelling.",
      "claim_ids": [
        "CL-6137-3.3.05-1",
        "CL-6137-3.3.05-2",
        "CL-6137-3.3.05-01-1",
