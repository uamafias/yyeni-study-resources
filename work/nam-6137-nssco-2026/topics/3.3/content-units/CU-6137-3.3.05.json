    {
      "block_id": "BL-6137-3.3.05-04",
      "block_type": "plain_explanation",
      "heading": "",
      "text": "Housing shortage concerns inadequate access to suitable accommodation, which can involve quantity, affordability, location or services. Empty high-cost homes can coexist with unmet need. A simple dwelling count therefore does not establish that everyone is housed adequately. Population, household size, income, tenure, condition and service access help identify the actual problem.",
      "claim_ids": [
        "CL-6137-3.3.05-1",
        "CL-6137-3.3.05-2",
        "CL-6137-3.3.05-01-1",
