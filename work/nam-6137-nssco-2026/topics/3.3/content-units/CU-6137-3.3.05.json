  "blocks": [
    {
      "block_id": "BL-6137-3.3.05-01",
      "block_type": "definition",
      "heading": "Urban growth problems and responses",
      "text": "Urban growth can increase demand for housing, serviced land, transport, jobs and public facilities. Problems can arise when access or capacity does not keep pace, while the city can also create opportunities. The explanation needs the specific mismatch rather than the claim that growth is automatically harmful. Residents face different conditions, and a national or city average can conceal serious local shortages.",
      "claim_ids": [
