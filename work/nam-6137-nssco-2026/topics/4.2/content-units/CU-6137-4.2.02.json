    {
      "block_id": "BL-6137-4.2.02-07",
      "block_type": "plain_explanation",
      "heading": "",
      "text": "A smaller second number in a one-to-n gradient means a steeper slope: 1:20 is steeper than 1:50 because the same rise occurs over a shorter horizontal run. Do not reverse the ratio or compare raw altitude totals instead of their difference. A higher endpoint does not by itself establish the steepest gradient; horizontal distance also matters.",
      "claim_ids": [
        "CL-6137-4.2.02-1",
        "CL-6137-4.2.02-2",
        "CL-6137-4.2.02-01-1",
        "CL-6137-4.2.02-01-2",
        "CL-6137-4.2.02-02-1",
        "CL-6137-4.2.02-02-2",
