    {
      "block_id": "BL-6137-4.2.02-12",
      "block_type": "plain_explanation",
      "heading": "",
      "text": "Area units need separate attention. One square kilometre is 1,000 metres by 1,000 metres, or one million square metres. A four-square-kilometre rectangle therefore has four million square metres. Converting an area by the linear factor of 1,000 would be wrong. The operation uses the square because both dimensions change unit.",
      "claim_ids": [
        "CL-6137-4.2.02-1",
