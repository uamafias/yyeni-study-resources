      "authored_hash": "99a9ccef4017ee812701ae633971ad3346fddfa13162ece795400c96dd96afb5"
    },
    {
      "block_id": "BL-6137-4.2.02-10",
      "block_type": "plain_explanation",
      "heading": "",
      "text": "The calculation record should therefore show measured or supplied values, compatible-unit conversion, arithmetic and final unit or ratio. Check whether the question asks straight distance, route distance, area or gradient before choosing a formula. A correct operation on the wrong measure still answers a different question, so the definitions matter as much as the arithmetic.",
      "claim_ids": [
