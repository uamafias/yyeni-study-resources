    {
      "block_id": "BL-6137-4.2.02-08",
      "block_type": "plain_explanation",
      "heading": "",
      "text": "The gradient describes the chosen endpoints and average horizontal run. The ground between can vary in steepness, so 1:50 does not prove a uniform slope at every point. Follow a requested line rather than the road length unless the task specifies that method. A surface distance measured along the slope differs from the horizontal map distance used in the usual calculation here.",
      "claim_ids": [
        "CL-6137-4.2.02-1",
        "CL-6137-4.2.02-2",
        "CL-6137-4.2.02-01-1",
        "CL-6137-4.2.02-01-2",
        "CL-6137-4.2.02-02-1",
