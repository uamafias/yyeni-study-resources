    {
      "block_id": "BL-6137-4.2.02-06",
      "block_type": "plain_explanation",
      "heading": "",
      "text": "Gradient compares vertical change with horizontal ground distance. Express both in the same unit before simplifying rise:run. If A is 1,500 metres and B 1,540 metres, vertical difference is forty metres. Their horizontal separation is two kilometres, or 2,000 metres. The ratio 40:2,000 simplifies to 1:50, meaning one unit vertically for fifty horizontally on average over that line.",
      "claim_ids": [
        "CL-6137-4.2.02-1",
        "CL-6137-4.2.02-2",
        "CL-6137-4.2.02-01-1",
        "CL-6137-4.2.02-01-2",
        "CL-6137-4.2.02-02-1",
        "CL-6137-4.2.02-02-2",
        "CL-6137-4.2.02-03-1",
        "CL-6137-4.2.02-03-2"
      ],
      "context_tags": [
        "Geography",
        "original teaching"
      ],
      "assessment_objectives": [
        "A",
        "B",
        "C"
      ],
      "claims_seen": {
        "CL-6137-4.2.02-1": 1,
        "CL-6137-4.2.02-2": 1,
        "CL-6137-4.2.02-01-1": 1,
        "CL-6137-4.2.02-01-2": 1,
        "CL-6137-4.2.02-02-1": 1,
