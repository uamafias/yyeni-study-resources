    {
      "block_id": "BL-6137-4.2.02-14",
      "block_type": "plain_explanation",
      "heading": "",
      "text": "Another gradient example holds height change constant. Forty metres over 800 metres gives a ratio of 1:20, steeper than forty over 2,000 metres at 1:50. The greater altitude is not the deciding feature; the rise relative to horizontal run is. Conversely, equal gradients can occur at different elevations because gradient concerns change rather than absolute height above the vertical reference.",
      "claim_ids": [
        "CL-6137-4.2.02-1",
        "CL-6137-4.2.02-2",
        "CL-6137-4.2.02-01-1",
        "CL-6137-4.2.02-01-2",
        "CL-6137-4.2.02-02-1",
        "CL-6137-4.2.02-02-2",
