    {
      "block_id": "BL-6137-4.2.02-03",
      "block_type": "plain_explanation",
      "heading": "",
      "text": "Area involves two dimensions. At 1:50,000, a one-centimetre square represents half a kilometre by half a kilometre, or 0.25 square kilometres. It does not represent half a square kilometre. A rectangle four centimetres by two centimetres represents two kilometres by one kilometre, or two square kilometres. Convert both dimensions before multiplying, or square the correct linear conversion factor.",
      "claim_ids": [
        "CL-6137-4.2.02-1",
        "CL-6137-4.2.02-2",
        "CL-6137-4.2.02-01-1",
        "CL-6137-4.2.02-01-2",
