  "blocks": [
    {
      "block_id": "BL-6137-4.2.04-01",
      "block_type": "definition",
      "heading": "Contours, symbols and landforms",
      "text": "Contours connect points at the same elevation relative to the map's stated vertical reference. Their labels and interval support relief interpretation. Close contours indicate steeper ground than wider spacing where the interval and scale are comparable. A contour is not a route or a fence, even if its line passes near buildings. Its meaning comes from equal height.",
      "claim_ids": [
        "CL-6137-4.2.04-1",
        "CL-6137-4.2.04-2",
        "CL-6137-4.2.04-01-1",
        "CL-6137-4.2.04-01-2",
        "CL-6137-4.2.04-02-1",
        "CL-6137-4.2.04-02-2"
      ],
      "context_tags": [
        "Geography",
        "original teaching"
      ],
      "assessment_objectives": [
        "A",
        "B",
        "C"
      ],
      "claims_seen": {
        "CL-6137-4.2.04-1": 1,
        "CL-6137-4.2.04-2": 1,
        "CL-6137-4.2.04-01-1": 1,
        "CL-6137-4.2.04-01-2": 1,
