    {
      "block_id": "BL-6137-4.2.01-12",
      "block_type": "plain_explanation",
      "heading": "",
      "text": "A map provides evidence of recorded locations and features, not every cause or present condition. A river beside cultivation can support a proximity description, while deliberate irrigation needs an application or infrastructure symbol if that conclusion is required. A road can show a connection without proving frequent public transport. Separate direct observation from a plausible suggestion supported by the stated evidence.",
      "claim_ids": [
        "CL-6137-4.2.01-1",
        "CL-6137-4.2.01-2",
        "CL-6137-4.2.01-01-1",
        "CL-6137-4.2.01-01-2",
        "CL-6137-4.2.01-02-1",
        "CL-6137-4.2.01-02-2",
        "CL-6137-4.2.01-03-1",
