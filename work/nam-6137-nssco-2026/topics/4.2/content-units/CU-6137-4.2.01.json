    {
      "block_id": "BL-6137-4.2.01-05",
      "block_type": "plain_explanation",
      "heading": "",
      "text": "Scale is the relationship between a map length and the corresponding ground length. At 1:50,000, one unit on the map represents 50,000 of the same units on the ground. One centimetre represents 50,000 centimetres, which is 500 metres or half a kilometre. The ratio uses like units. It does not mean one centimetre is 50,000 metres.",
      "claim_ids": [
        "CL-6137-4.2.01-1",
        "CL-6137-4.2.01-2",
        "CL-6137-4.2.01-01-1",
        "CL-6137-4.2.01-01-2",
