    {
      "block_id": "BL-6137-4.2.07-14",
      "block_type": "plain_explanation",
      "heading": "",
      "text": "Longitude and latitude have different numerical ranges and reference lines. Latitude runs from the Equator towards ninety degrees north or south, while longitude extends east or west from the prime meridian towards 180 degrees. A southern latitude should not be written with an east suffix. The coordinate pair needs each quantity and direction attached to the correct value.",
      "claim_ids": [
        "CL-6137-4.2.07-1",
        "CL-6137-4.2.07-2",
        "CL-6137-4.2.07-01-1",
        "CL-6137-4.2.07-01-2",
        "CL-6137-4.2.07-02-1",
        "CL-6137-4.2.07-02-2",
