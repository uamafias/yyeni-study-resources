    {
      "block_id": "BL-6137-4.2.07-03",
      "block_type": "plain_explanation",
      "heading": "",
      "text": "Degrees divide into sixty minutes, and each minute into sixty seconds. These are angular units, not decimal fractions with a base of 100. The symbols °,′ and ″ distinguish them. To convert degrees, minutes and seconds to decimal degrees, add degrees plus minutes divided by sixty plus seconds divided by 3,600, retaining the hemisphere or appropriate sign.",
      "claim_ids": [
        "CL-6137-4.2.07-1",
        "CL-6137-4.2.07-2",
        "CL-6137-4.2.07-01-1",
        "CL-6137-4.2.07-01-2",
        "CL-6137-4.2.07-02-1",
        "CL-6137-4.2.07-02-2",
        "CL-6137-4.2.07-03-1",
        "CL-6137-4.2.07-03-2"
      ],
      "context_tags": [
        "Geography",
        "original teaching"
