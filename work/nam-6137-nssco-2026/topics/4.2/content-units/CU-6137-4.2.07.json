    {
      "block_id": "BL-6137-4.2.07-02",
      "block_type": "plain_explanation",
      "heading": "",
      "text": "Lines of latitude run around the Earth parallel to the Equator, while their values measure north–south position. Meridians of longitude run between the poles, while their values measure east–west position. The direction of a line and the direction its numeric value locates are therefore different. Do not call a longitude value a measure of distance north simply because the meridian appears vertical on a map.",
      "claim_ids": [
        "CL-6137-4.2.07-1",
        "CL-6137-4.2.07-2",
        "CL-6137-4.2.07-01-1",
        "CL-6137-4.2.07-01-2",
        "CL-6137-4.2.07-02-1",
        "CL-6137-4.2.07-02-2",
        "CL-6137-4.2.07-03-1",
        "CL-6137-4.2.07-03-2"
      ],
      "context_tags": [
        "Geography",
        "original teaching"
      ],
      "assessment_objectives": [
        "A",
        "B",
        "C"
      ],
      "claims_seen": {
