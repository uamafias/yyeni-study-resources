    {
      "block_id": "BL-6137-2.3.05-11",
      "block_type": "plain_explanation",
      "heading": "",
      "text": "Cultural advantages can include opportunities to share language, heritage, skills or artistic work on terms chosen by host communities. Visitor demand can support crafts, performances or heritage interpretation, potentially providing income and reasons to maintain valued practices. Respect, consent and control matter. Cultural exchange should not be reduced to a claim that all contact improves understanding; benefits require the hosts' ability to decide what is shared and how.",
      "claim_ids": [
        "CL-6137-2.3.05-1",
        "CL-6137-2.3.05-2",
        "CL-6137-2.3.05-01-1",
        "CL-6137-2.3.05-01-2",
        "CL-6137-2.3.05-02-1",
