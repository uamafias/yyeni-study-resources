 "blooms_taxonomy": {
  "scheme": "Revised Bloom's taxonomy (Anderson and Krathwohl).",
  "why_both": "The assessment objective says what the examination credits. The Bloom level says what the learner is being asked to do. They are different axes and every item carries both.",
  "levels": [
   {
    "level": "Remember",
    "means": "Recall a fact, a term or a list, as stated."
   },
   {
    "level": "Understand",
    "means": "Explain an idea in the learner’s own words, or tell it apart from a neighbouring one."
   },
   {
    "level": "Apply",
    "means": "Use the idea on a case, a figure, a program or a diagram the learner has not been given the answer to."
   },
   {
    "level": "Analyse",
    "means": "Break a situation into its parts and trace a cause through to its consequence."
   },
   {
    "level": "Evaluate",
    "means": "Weigh options against a criterion and reach a justified choice that could have gone the other way."
   },
   {
    "level": "Create",
    "means": "Build something new from the parts: a design, an algorithm, a plan."
   }
  ],
