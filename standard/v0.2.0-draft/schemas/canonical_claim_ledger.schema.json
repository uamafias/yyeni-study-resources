{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yyeni.example/schemas/canonical_claim_ledger.schema.json",
  "title": "YYeni Canonical Claim Ledger",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "ledger_id",
    "claims"
  ],
  "properties": {
    "ledger_id": {
      "type": "string"
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "claim_id",
          "objective_ids",
          "text",
          "claim_type",
          "provenance",
          "evidence",
          "derived_from_claim_ids",
          "verification",
          "publishable"
        ],
        "properties": {
          "claim_id": {
            "type": "string"
          },
          "objective_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "claim_type": {
            "type": "string",
            "enum": [
              "definition",
              "factual",
              "formula",
              "procedural",
              "comparison",
              "causal",
              "evaluative",
              "inference",
              "synthetic_example",
              "misconception_correction"
            ]
          },
          "provenance": {
            "type": "string",
            "enum": [
              "syllabus_direct",
              "source_derived",
              "source_synthesised",
              "source_corrected",
              "generated_gap",
              "generated_quality",
              "reasoned_extension",
              "verified_external"
            ]
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "source_id",
                "locator",
                "support_type"
              ],
              "properties": {
                "source_id": {
                  "type": "string"
                },
                "locator": {
                  "type": "string"
                },
                "support_type": {
                  "type": "string",
                  "enum": [
                    "direct",
                    "paraphrase",
                    "corroboration",
                    "correction",
                    "derivation"
                  ]
                }
              }
            }
          },
          "derived_from_claim_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "verification": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "status",
              "method",
              "reviewer_id",
              "reviewed_at",
              "confidence"
            ],
            "properties": {
              "status": {
                "type": "string",
                "enum": [
                  "unverified",
                  "verified",
                  "human_approved",
                  "rejected"
                ]
              },
              "method": {
                "type": "string"
              },
              "reviewer_id": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "reviewed_at": {
                "type": [
                  "string",
                  "null"
                ],
                "format": "date-time"
              },
              "confidence": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            }
          },
          "publishable": {
            "type": "boolean"
          },
          "notes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "generality": {
            "type": "string",
            "enum": [
              "definitional",
              "legal",
              "arithmetic"
            ],
            "description": "RS-33. Present only where a universal or exclusivity statement is genuinely correct, recording why."
          },
          "revision": {
            "type": "integer",
            "minimum": 1,
            "description": "RS-41. Bumped whenever the claim text changes."
          },
          "revised_at": {
            "type": "string",
            "description": "RS-41. Date of the last text change."
          }
        }
      }
    }
  }
}