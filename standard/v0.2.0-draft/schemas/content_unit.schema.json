{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yyeni.example/schemas/content_unit.schema.json",
  "title": "YYeni Content Unit",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "unit_id",
    "title",
    "objective_ids",
    "level",
    "core_status",
    "objective_type",
    "depth_tier",
    "word_budget",
    "blocks",
    "word_count",
    "qa_status"
  ],
  "properties": {
    "unit_id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "objective_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "level": {
      "type": "string"
    },
    "core_status": {
      "type": "string",
      "enum": [
        "core",
        "prerequisite",
        "enrichment"
      ]
    },
    "objective_type": {
      "type": "string"
    },
    "depth_tier": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4
    },
    "word_budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "min",
        "target",
        "max"
      ],
      "properties": {
        "min": {
          "type": "integer",
          "minimum": 0
        },
        "target": {
          "type": "integer",
          "minimum": 0
        },
        "max": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "blocks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "block_id",
          "block_type",
          "heading",
          "text",
          "claim_ids",
          "context_tags",
          "assessment_objectives"
        ],
        "properties": {
          "block_id": {
            "type": "string"
          },
          "block_type": {
            "type": "string",
            "enum": [
              "learner_objective",
              "key_question",
              "definition",
              "plain_explanation",
              "components",
              "process",
              "example",
              "non_example",
              "comparison",
              "benefit",
              "limitation",
              "stakeholder_effect",
              "worked_application",
              "analysis_chain",
              "evaluation",
              "formula",
              "worked_calculation",
              "interpretation",
              "misconception",
              "cross_link",
              "practice_guidance",
              "summary",
              "enrichment"
            ]
          },
          "heading": {
            "type": "string"
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "claim_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "context_tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "assessment_objectives": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "generalisation_scope": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "RS-34. The member objective IDs a grouping, family or across-the-board statement claims to hold for."
          },
          "claims_seen": {
            "type": "object",
            "additionalProperties": {
              "type": "integer",
              "minimum": 1
            },
            "description": "RS-41. claim_id -> the claim revision this block was authored against."
          },
          "authored_hash": {
            "type": "string",
            "description": "RS-41. SHA-256 of the block text this claims_seen stamp was made against."
          },
          "prior_hash": {
            "type": "string",
            "description": "RS-41. authored_hash before the current stamp."
          },
          "reviewed_unchanged": {
            "type": "string",
            "description": "RS-41. Recorded when a re-read against a revised claim genuinely found nothing to change."
          },
          "repair_note": {
            "type": "string",
            "description": "A written record of what this repair changed and why, the mirror of reviewed_unchanged. RS-41: a repair leaves a trail either way - what changed, or why re-reading found nothing to change."
          },
          "chart": {
            "type": "object",
            "description": "Declared parameters of a depiction this block shows. RS-47: the plot in the text is generated from these by build/render_chart.py and C-41 fails the build if the two ever differ.",
            "properties": {
              "price": {
                "type": "number"
              },
              "variable_cost": {
                "type": "number"
              },
              "fixed_costs": {
                "type": "number"
              },
              "current_output": {
                "type": "number"
              },
              "asks": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "word_count": {
      "type": "integer",
      "minimum": 0
    },
    "qa_status": {
      "type": "string",
      "enum": [
        "draft",
        "review_required",
        "approved",
        "rejected"
      ]
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}