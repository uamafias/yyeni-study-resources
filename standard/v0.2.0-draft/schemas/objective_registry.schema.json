{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yyeni.example/schemas/objective_registry.schema.json",
  "title": "YYeni Objective Registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "registry_id",
    "qualification_profile_id",
    "subject_profile_id",
    "objectives"
  ],
  "properties": {
    "registry_id": {
      "type": "string"
    },
    "qualification_profile_id": {
      "type": "string"
    },
    "subject_profile_id": {
      "type": "string"
    },
    "objectives": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "objective_id",
          "parent_id",
          "topic_id",
          "syllabus_text",
          "learner_objective",
          "level",
          "route_status",
          "mandatory",
          "objective_type",
          "assessment_objectives",
          "command_words",
          "prerequisite_ids",
          "related_ids",
          "depth_tier",
          "source_coverage",
          "status"
        ],
        "properties": {
          "objective_id": {
            "type": "string"
          },
          "parent_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "topic_id": {
            "type": "string"
          },
          "syllabus_text": {
            "type": "string"
          },
          "learner_objective": {
            "type": "string"
          },
          "level": {
            "type": "string"
          },
          "route_status": {
            "type": "string",
            "enum": [
              "core",
              "optional",
              "assumed",
              "excluded"
            ]
          },
          "mandatory": {
            "type": "boolean"
          },
          "objective_type": {
            "type": "string"
          },
          "assessment_objectives": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "command_words": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "prerequisite_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "related_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "cross_topic_concept_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "depth_tier": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4
          },
          "source_coverage": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "rating",
              "action",
              "rationale"
            ],
            "properties": {
              "rating": {
                "type": "integer",
                "minimum": 0,
                "maximum": 5
              },
              "action": {
                "type": "string",
                "enum": [
                  "retain",
                  "refine",
                  "synthesise",
                  "correct",
                  "regenerate",
                  "generate_gap",
                  "exclude"
                ]
              },
              "rationale": {
                "type": "string"
              }
            }
          },
          "status": {
            "type": "string",
            "enum": [
              "planned",
              "source_mapped",
              "drafted",
              "reviewed",
              "approved",
              "published",
              "deferred"
            ]
          },
          "sub_topic": {
            "type": "string",
            "description": "CR-004. The syllabus sub-topic number the objective sits under."
          },
          "sub_topic_heading": {
            "type": "string",
            "description": "CR-004. The syllabus's heading for that sub-topic."
          },
          "syllabus_page": {
            "type": "integer",
            "minimum": 1,
            "description": "CR-004. Page of the syllabus PDF that states syllabus_text."
          },
          "sub_objectives": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string"
            },
            "description": "CR-004. The syllabus's finer assessed grain this objective is tested under (0500: R1-R5, W1-W5)."
          },
          "task": {
            "type": "string",
            "description": "CR-004. The paper task the objective is assessed in, where the syllabus assesses by task rather than by topic."
          },
          "syllabus_guidance": {
            "type": "string",
            "description": "CR-004. Guidance the syllabus prints beside the objective (e.g. 0455's notes column), transcribed."
          },
          "papers": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "CR-006. The papers that assess this objective, where the syllabus assigns content to papers (9618: sections 1-8 Paper 1, 9-12 Paper 2). Read by make_work_order.py to re-express slot AOs for a paper that does not assess an AO."
          }
        }
      }
    },
    "generated_at": {
      "type": "string",
      "description": "CR-004. When the registry was generated."
    },
    "authority": {
      "type": "string",
      "description": "CR-004. The document the objectives are transcribed from."
    },
    "granularity_note": {
      "type": "string",
      "description": "CR-004. What one objective corresponds to in the syllabus."
    },
    "papers_note": {
      "type": "string",
      "description": "CR-006. How the syllabus assigns content to papers, where it does."
    }
  }
}