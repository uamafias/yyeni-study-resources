{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yyeni.example/schemas/source_inventory.schema.json",
  "title": "YYeni Source Inventory",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "inventory_id",
    "generated_at",
    "sources"
  ],
  "properties": {
    "inventory_id": {
      "type": "string"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_id",
          "original_filename",
          "content_hash",
          "file_type",
          "extraction",
          "authority_category",
          "levels",
          "topic_ids",
          "status"
        ],
        "properties": {
          "source_id": {
            "type": "string"
          },
          "original_filename": {
            "type": "string"
          },
          "content_hash": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "algorithm",
              "value"
            ],
            "properties": {
              "algorithm": {
                "type": "string",
                "enum": [
                  "sha256"
                ]
              },
              "value": {
                "type": "string",
                "pattern": "^[a-fA-F0-9]{64}$"
              }
            }
          },
          "file_type": {
            "type": "string"
          },
          "size_bytes": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "page_count": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          },
          "duplicate_group": {
            "type": [
              "string",
              "null"
            ]
          },
          "extraction": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "text_status",
              "visual_status",
              "ocr_required",
              "table_status",
              "formula_status"
            ],
            "properties": {
              "text_status": {
                "type": "string",
                "enum": [
                  "not_checked",
                  "complete",
                  "partial",
                  "none",
                  "failed"
                ]
              },
              "visual_status": {
                "type": "string",
                "enum": [
                  "not_checked",
                  "not_needed",
                  "reviewed",
                  "partial",
                  "failed"
                ]
              },
              "ocr_required": {
                "type": "boolean"
              },
              "table_status": {
                "type": "string",
                "enum": [
                  "not_checked",
                  "not_present",
                  "captured",
                  "partial",
                  "failed"
                ]
              },
              "formula_status": {
                "type": "string",
                "enum": [
                  "not_checked",
                  "not_present",
                  "captured",
                  "partial",
                  "failed"
                ]
              },
              "notes": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          },
          "authority_category": {
            "type": "string",
            "enum": [
              "official_curriculum",
              "official_assessment",
              "endorsed_conceptual",
              "reputable_supporting",
              "teacher_created",
              "learner_notes",
              "uncertain",
              "unusable"
            ]
          },
          "likely_syllabus_versions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "levels": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "topic_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "publication_date": {
            "type": [
              "string",
              "null"
            ],
            "format": "date"
          },
          "quality_flags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "reuse_constraints": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "status": {
            "type": "string",
            "enum": [
              "active",
              "duplicate",
              "out_of_scope",
              "unusable",
              "reference_only"
            ]
          },
          "notes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
