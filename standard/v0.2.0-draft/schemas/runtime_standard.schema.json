{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yyeni.example/schemas/runtime_standard.schema.json",
  "title": "YYeni Runtime Standard",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "standard_id",
    "version",
    "status",
    "purpose",
    "rules",
    "required_artifacts",
    "release_blockers"
  ],
  "properties": {
    "standard_id": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "approved",
        "superseded"
      ]
    },
    "purpose": {
      "type": "string"
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "rule_id",
          "category",
          "requirement",
          "blocking"
        ],
        "properties": {
          "rule_id": {
            "type": "string",
            "pattern": "^RS-[0-9]{2}$"
          },
          "category": {
            "type": "string"
          },
          "requirement": {
            "type": "string"
          },
          "blocking": {
            "type": "boolean"
          }
        }
      }
    },
    "required_artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "release_blockers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    }
  }
}
