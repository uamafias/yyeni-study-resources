{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yyeni.example/schemas/learning_items.schema.json",
  "title": "YYeni Learning Item Dataset",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "dataset_id",
    "topic_id",
    "items"
  ],
  "properties": {
    "dataset_id": {
      "type": "string"
    },
    "topic_id": {
      "type": "string"
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "item_id",
          "objective_ids",
          "claim_ids",
          "item_type",
          "subtype",
          "assessment_objectives",
          "difficulty",
          "prompt",
          "canonical_answer",
          "marking_guidance",
          "context",
          "prerequisite_item_ids",
          "core_status",
          "intentional_duplicate_group",
          "provenance",
          "qa_status"
        ],
        "properties": {
          "item_id": {
            "type": "string"
          },
          "objective_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "claim_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "item_type": {
            "type": "string",
            "enum": [
              "flashcard",
              "short_answer",
              "calculation",
              "worked_example",
              "data_response",
              "essay_plan",
              "essay_question",
              "case_analysis",
              "practical_task",
              "multiple_choice_set",
              "source_analysis",
              "speaking_prompt",
              "writing_task",
              "listening_task"
            ]
          },
          "subtype": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "DEF",
              "FEATURE",
              "DIST",
              "PROC",
              "WHY",
              "MECH",
              "BEN",
              "LIM",
              "APP",
              "CHAIN",
              "EVAL",
              "CALC",
              "INTERP",
              "MISCON",
              "SYNTH",
              null
            ]
          },
          "assessment_objectives": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "difficulty": {
            "type": "integer",
            "minimum": 1,
            "maximum": 6
          },
          "prompt": {
            "type": "string",
            "minLength": 1
          },
          "canonical_answer": {
            "type": [
              "string",
              "null"
            ]
          },
          "marking_guidance": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "context": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "sector",
              "business_size",
              "ownership",
              "situation",
              "facts"
            ],
            "properties": {
              "sector": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "business_size": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "ownership": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "situation": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "facts": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "chart": {
                "type": "object",
                "additionalProperties": false,
                "description": "RS-22. Declared parameters of a graphical stimulus so its coordinates can be verified.",
                "required": [
                  "price",
                  "variable_cost",
                  "fixed_costs",
                  "asks"
                ],
                "properties": {
                  "price": {
                    "type": "number"
                  },
                  "variable_cost": {
                    "type": "number"
                  },
                  "fixed_costs": {
                    "type": "number"
                  },
                  "current_output": {
                    "type": "number"
                  },
                  "asks": {
                    "type": "string"
                  }
                }
              },
              "text_id": {
                "type": "string",
                "description": "CR-004. The practice text this item is answered from: topics/<T>/texts/<text_id>.md. An original text written for the purpose, never a reproduced one."
              }
            }
          },
          "prerequisite_item_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "core_status": {
            "type": "string",
            "enum": [
              "core",
              "prerequisite",
              "enrichment"
            ]
          },
          "intentional_duplicate_group": {
            "type": [
              "string",
              "null"
            ]
          },
          "provenance": {
            "type": "string"
          },
          "qa_status": {
            "type": "string",
            "enum": [
              "draft",
              "review_required",
              "approved",
              "rejected"
            ]
          },
          "claims_seen": {
            "type": "object",
            "additionalProperties": {
              "type": "integer",
              "minimum": 1
            },
            "description": "RS-41. claim_id -> the claim revision this item was authored against."
          },
          "authored_hash": {
            "type": "string",
            "description": "RS-41. SHA-256 of the item text this claims_seen stamp was made against."
          },
          "prior_hash": {
            "type": "string",
            "description": "RS-41. authored_hash before the current stamp."
          },
          "reviewed_unchanged": {
            "type": "string",
            "description": "RS-41. Recorded when a re-read against a revised claim genuinely found nothing to change."
          },
          "repair_note": {
            "type": "string",
            "description": "A written record of what this repair changed and why, the mirror of reviewed_unchanged. RS-41: a repair leaves a trail either way - what changed, or why re-reading found nothing to change."
          },
          "blooms_level": {
            "type": "string",
            "enum": [
              "Remember",
              "Understand",
              "Apply",
              "Analyse",
              "Evaluate",
              "Create"
            ],
            "description": "CR-004. What the learner is asked to do (revised Bloom's taxonomy). A different axis from assessment_objectives; the work order decides it per slot."
          },
          "blooms_level_basis": {
            "type": "string",
            "description": "CR-004. How blooms_level was decided, when it was derived rather than authored (e.g. by subtype rule)."
          },
          "command_word": {
            "type": [
              "string",
              "null"
            ],
            "description": "CR-004. The command word or task form the item models, from the work-order slot. Null for a technique card that models no paper question."
          },
          "mark_tariff": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0,
            "description": "CR-004. Marks of the paper question or task part this item models, from the work-order slot. Null when it models none."
          },
          "sub_objectives": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string"
            },
            "description": "CR-004. The syllabus's own finer assessed grain beneath assessment_objectives, where it prints one (0500: R1-R5, W1-W5). Absent where the syllabus prints none."
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "item_type": {
                  "const": "flashcard"
                }
              }
            },
            "then": {
              "properties": {
                "canonical_answer": {
                  "type": "string",
                  "minLength": 1
                },
                "subtype": {
                  "type": "string",
                  "enum": [
                    "DEF",
                    "FEATURE",
                    "DIST",
                    "PROC",
                    "WHY",
                    "MECH",
                    "BEN",
                    "LIM",
                    "APP",
                    "CHAIN",
                    "EVAL",
                    "CALC",
                    "INTERP",
                    "MISCON",
                    "SYNTH"
                  ]
                }
              }
            }
          }
        ]
      }
    }
  }
}
