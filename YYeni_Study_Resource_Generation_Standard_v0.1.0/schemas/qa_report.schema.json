{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yyeni.example/schemas/qa_report.schema.json",
  "title": "YYeni QA Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "qa_report_id",
    "build_id",
    "generated_at",
    "deterministic_checks",
    "semantic_reviews",
    "blockers",
    "metrics",
    "release_decision"
  ],
  "properties": {
    "qa_report_id": {
      "type": "string"
    },
    "build_id": {
      "type": "string"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "deterministic_checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "check_id",
          "status",
          "message",
          "affected_ids"
        ],
        "properties": {
          "check_id": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "pass",
              "fail",
              "warn",
              "not_run"
            ]
          },
          "message": {
            "type": "string"
          },
          "affected_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "semantic_reviews": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "review_id",
          "reviewer_role",
          "status",
          "issues"
        ],
        "properties": {
          "review_id": {
            "type": "string"
          },
          "reviewer_role": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "pass",
              "conditional_pass",
              "reject",
              "not_run"
            ]
          },
          "issues": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "issue_id",
                "severity",
                "category",
                "affected_ids",
                "finding",
                "evidence",
                "educational_consequence",
                "recommended_repair",
                "confidence",
                "status"
              ],
              "properties": {
                "issue_id": {
                  "type": "string"
                },
                "severity": {
                  "type": "string",
                  "enum": [
                    "critical",
                    "high",
                    "medium",
                    "low"
                  ]
                },
                "category": {
                  "type": "string"
                },
                "affected_ids": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "finding": {
                  "type": "string"
                },
                "evidence": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "educational_consequence": {
                  "type": "string"
                },
                "recommended_repair": {
                  "type": "string"
                },
                "confidence": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "status": {
                  "type": "string",
                  "enum": [
                    "open",
                    "accepted",
                    "rejected",
                    "resolved"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "objective_count",
        "claim_count",
        "content_unit_count",
        "learning_item_count",
        "word_count"
      ],
      "properties": {
        "objective_count": {
          "type": "integer",
          "minimum": 0
        },
        "claim_count": {
          "type": "integer",
          "minimum": 0
        },
        "content_unit_count": {
          "type": "integer",
          "minimum": 0
        },
        "learning_item_count": {
          "type": "integer",
          "minimum": 0
        },
        "word_count": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "release_decision": {
      "type": "string",
      "enum": [
        "pass",
        "hold",
        "reject"
      ]
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
