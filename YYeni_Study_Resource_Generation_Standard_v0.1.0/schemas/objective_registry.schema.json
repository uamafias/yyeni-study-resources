{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yyeni.example/schemas/objective_registry.schema.json",
  "title": "YYeni Objective Registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "registry_id",
    "qualification_profile_id",
    "subject_profile_id",
    "objectives"
  ],
  "properties": {
    "registry_id": {
      "type": "string"
    },
    "qualification_profile_id": {
      "type": "string"
    },
    "subject_profile_id": {
      "type": "string"
    },
    "objectives": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "objective_id",
          "parent_id",
          "topic_id",
          "syllabus_text",
          "learner_objective",
          "level",
          "route_status",
          "mandatory",
          "objective_type",
          "assessment_objectives",
          "command_words",
          "prerequisite_ids",
          "related_ids",
          "depth_tier",
          "source_coverage",
          "status"
        ],
        "properties": {
          "objective_id": {
            "type": "string"
          },
          "parent_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "topic_id": {
            "type": "string"
          },
          "syllabus_text": {
            "type": "string"
          },
          "learner_objective": {
            "type": "string"
          },
          "level": {
            "type": "string"
          },
          "route_status": {
            "type": "string",
            "enum": [
              "core",
              "optional",
              "assumed",
              "excluded"
            ]
          },
          "mandatory": {
            "type": "boolean"
          },
          "objective_type": {
            "type": "string"
          },
          "assessment_objectives": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "command_words": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "prerequisite_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "related_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "cross_topic_concept_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "depth_tier": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4
          },
          "source_coverage": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "rating",
              "action",
              "rationale"
            ],
            "properties": {
              "rating": {
                "type": "integer",
                "minimum": 0,
                "maximum": 5
              },
              "action": {
                "type": "string",
                "enum": [
                  "retain",
                  "refine",
                  "synthesise",
                  "correct",
                  "regenerate",
                  "generate_gap",
                  "exclude"
                ]
              },
              "rationale": {
                "type": "string"
              }
            }
          },
          "status": {
            "type": "string",
            "enum": [
              "planned",
              "source_mapped",
              "drafted",
              "reviewed",
              "approved",
              "published",
              "deferred"
            ]
          }
        }
      }
    }
  }
}
