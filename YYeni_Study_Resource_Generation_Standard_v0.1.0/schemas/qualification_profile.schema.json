{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yyeni.example/schemas/qualification_profile.schema.json",
  "title": "YYeni Qualification Profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "profile_id",
    "version",
    "board",
    "qualification",
    "subject",
    "syllabus_code",
    "examination_years",
    "syllabus_version",
    "selected_level",
    "route",
    "language",
    "papers",
    "assessment_objectives",
    "command_words",
    "scope",
    "source_authority"
  ],
  "properties": {
    "profile_id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "approved",
        "superseded"
      ]
    },
    "board": {
      "type": "string",
      "minLength": 1
    },
    "qualification": {
      "type": "string",
      "minLength": 1
    },
    "subject": {
      "type": "string",
      "minLength": 1
    },
    "syllabus_code": {
      "type": "string",
      "minLength": 1
    },
    "examination_years": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "integer",
        "minimum": 2000
      }
    },
    "syllabus_version": {
      "type": "string",
      "minLength": 1
    },
    "syllabus_published_date": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "selected_level": {
      "type": "string",
      "minLength": 1
    },
    "route": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "route_id",
        "name",
        "included_paper_ids"
      ],
      "properties": {
        "route_id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "included_paper_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "excluded_paper_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "language": {
      "type": "string",
      "minLength": 1
    },
    "guided_learning_hours": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "learner_entry_assumptions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "key_concepts": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "papers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "paper_id",
          "name",
          "duration_minutes",
          "marks",
          "qualification_weight_percent",
          "question_basis",
          "assessment_objective_weights"
        ],
        "properties": {
          "paper_id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "duration_minutes": {
            "type": "integer",
            "minimum": 1
          },
          "marks": {
            "type": "integer",
            "minimum": 1
          },
          "qualification_weight_percent": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "question_basis": {
            "type": "string"
          },
          "sections": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "evaluation_locations": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "assessment_objective_weights": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            }
          }
        }
      }
    },
    "assessment_objectives": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "name",
          "description",
          "qualification_weight_percent"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "qualification_weight_percent": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          }
        }
      }
    },
    "command_words": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "word",
          "meaning"
        ],
        "properties": {
          "word": {
            "type": "string"
          },
          "meaning": {
            "type": "string"
          }
        }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "included_topic_ids",
        "excluded_topic_ids",
        "optional_routes"
      ],
      "properties": {
        "included_topic_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "excluded_topic_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "assumed_topic_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "optional_routes": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "option_group_id",
              "selection_rule",
              "topic_ids"
            ],
            "properties": {
              "option_group_id": {
                "type": "string"
              },
              "selection_rule": {
                "type": "string"
              },
              "topic_ids": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "source_authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "curricular",
        "assessment",
        "conceptual"
      ],
      "properties": {
        "curricular": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "assessment": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "conceptual": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "conflict_rule": {
          "type": "string"
        }
      }
    },
    "example_selection_rules": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
