{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yyeni.example/schemas/content_unit.schema.json",
  "title": "YYeni Content Unit",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "unit_id",
    "title",
    "objective_ids",
    "level",
    "core_status",
    "objective_type",
    "depth_tier",
    "word_budget",
    "blocks",
    "word_count",
    "qa_status"
  ],
  "properties": {
    "unit_id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "objective_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "level": {
      "type": "string"
    },
    "core_status": {
      "type": "string",
      "enum": [
        "core",
        "prerequisite",
        "enrichment"
      ]
    },
    "objective_type": {
      "type": "string"
    },
    "depth_tier": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4
    },
    "word_budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "min",
        "target",
        "max"
      ],
      "properties": {
        "min": {
          "type": "integer",
          "minimum": 0
        },
        "target": {
          "type": "integer",
          "minimum": 0
        },
        "max": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "blocks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "block_id",
          "block_type",
          "heading",
          "text",
          "claim_ids",
          "context_tags",
          "assessment_objectives"
        ],
        "properties": {
          "block_id": {
            "type": "string"
          },
          "block_type": {
            "type": "string",
            "enum": [
              "learner_objective",
              "key_question",
              "definition",
              "plain_explanation",
              "components",
              "process",
              "example",
              "non_example",
              "comparison",
              "benefit",
              "limitation",
              "stakeholder_effect",
              "worked_application",
              "analysis_chain",
              "evaluation",
              "formula",
              "worked_calculation",
              "interpretation",
              "misconception",
              "cross_link",
              "practice_guidance",
              "summary",
              "enrichment"
            ]
          },
          "heading": {
            "type": "string"
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "claim_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "context_tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "assessment_objectives": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "word_count": {
      "type": "integer",
      "minimum": 0
    },
    "qa_status": {
      "type": "string",
      "enum": [
        "draft",
        "review_required",
        "approved",
        "rejected"
      ]
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
